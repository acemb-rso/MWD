<div id="gm-manager" class="app window-app {{cssClass}}" data-appid="{{options.id}}">
  <header class="gm-manager-header">
    <h4 class="window-title">{{ANARCHY.gmManager.title}}</h4>
    <button type="button" class="header-button control" data-action="hideManager" aria-label="Close">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </header>

  <div class="gm-manager-content">
    {{!-- Plot Points Widget --}}
    <div class="gm-manager-bar anarchy-monitor" data-widget="plotpoint">
      <div class="widget-header">
        <label>{{ANARCHY.actor.counters.plot}}</label>
      </div>
      <div class="widget-content">
        <span class="flex-grow-3 gm-anarchy-bar">
          {{> "systems/mwd/templates/monitors/anarchy.hbs"
            code='plot'
            rowlength=6
            value=widgets.0.content.value
            max=widgets.0.content.max
            scene=0
            label=ANARCHY.actor.counters.plot
          }}
        </span>
      </div>
    </div>

    {{!-- Difficulty Pools Widget --}}
    <div class="gm-manager-bar" data-widget="difficulty">
      <div class="widget-header">
        <label>Difficulty Pools</label>
      </div>
      <div class="widget-content">
        <span class="flex-grow-2 gm-difficulty-bar">
          {{> 'systems/mwd/templates/app/gm-difficulty-buttons.hbs'
            difficultyPools=widgets.1.content.difficultyPools
          }}
        </span>
      </div>
    </div>
  </div>

  {{!-- Resize Handle --}}
  <div class="gm-manager-resize-handle" title="Drag to resize"></div>
</div>
