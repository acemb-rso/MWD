{{!--
templates/app/gm-difficulty-buttons.hbs
Purpose: Renders collections with `each` blocks. Contains conditional display logic. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


{{#each difficultyPools}}
<a class="click-roll-difficulty-pool" 
   data-pool="{{pool}}" 
   data-difficulty="{{difficulty}}"
   title="Roll {{pool}}d6 for {{difficulty}} difficulty">
  {{#if difficulty}}{{difficulty}}: {{/if}}{{pool}}d6
</a>
{{/each}}
