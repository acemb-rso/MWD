{{#if anarchy.max}}
<div class="flexcol anarchy-monitor">
  {{#if (or anarchy.isGM @root.options.isOwned)}}
    <label class="info-label">
      {{ANARCHY.actor.counters.sceneAnarchy}}
    </label>
  {{else}}
    <label class="info-label">
      {{ANARCHY.actor.counters.anarchy}}
    </label>
    {{> "systems/mwd/templates/monitors/anarchy.hbs"
      code='anarchy'
      label=ANARCHY.actor.counters.anarchy
      rowlength=6
      value=anarchy.value
      max=anarchy.max
    }}
  {{/if}}
  {{> "systems/mwd/templates/monitors/anarchy-scene.hbs"
      code='sceneAnarchy'
      label=ANARCHY.actor.counters.sceneAnarchy
      rowlength=6
      value=anarchy.scene
      max=anarchy.scene
  }}
</div>
{{/if}}
