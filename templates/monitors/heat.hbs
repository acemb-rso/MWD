{{!--
templates/monitors/heat.hbs
Purpose: Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="flexcol anarchy-monitor">
  <label class="monitor-label">{{ANARCHY.actor.monitors.heat}}</label>
  {{> "systems/mwd/templates/common/checkbar.hbs"
    code='heat'
    value=system.monitors.heat.value
    max=(sum system.monitors.heat.max system.monitors.heat.maxBonus)
    rowlength=3
    adjust=true
  }}
  <label class="resitance-label">
    {{ANARCHY.actor.monitors.resistance}}:
    {{system.monitors.heat.resistanceBonus}}
  </label>
</div>
