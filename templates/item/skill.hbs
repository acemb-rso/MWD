{{!--
templates/item/skill.hbs
Purpose: Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="{{cssClass}}">
  <header class="sheet-header">
    <img class="anarchy-img profile-img" src="{{item.img}}" data-action="editImage" data-tooltip="{{item.name}}"/>
    {{> 'systems/mwd/templates/item/parts/itemname.hbs'
      label=ANARCHY.itemType.singular.skill
      type="skill"
    }}
  </header>

  <section class="sheet-body">
    <div class="form-group">
      <label>{{ANARCHY.item.skill.code}}</label>
      <select class="select-skill-code" name="system.code" data-dtype="String">
        {{#select system.code}}
          {{> 'systems/mwd/templates/common/enum-value-label.hbs' entries=ENUMS.skills}}
        {{/select}}
      </select>
    </div>

    {{#unless (or (eq system.code 'knowledge') (eq system.attribute 'knowledge'))}}
      <div class="form-group">
        <label for="system.value">{{ANARCHY.item.skill.value}}</label>
        <input class="type-numeric" type="number" name="system.value" value="{{system.value}}" data-dtype="Number"/>
      </div>

      <div class="form-group">
        <label for="system.attribute">{{ANARCHY.item.skill.attribute}}</label>
        <select class="item-field-value" name="system.attribute" data-dtype="String">
          {{#select system.attribute}}
            {{> 'systems/mwd/templates/common/enum-value-label.hbs' entries=ENUMS.attributes}}
          {{/select}}
        </select>
      </div>

      <div class="form-group">
        <label for="system.specialization">{{ANARCHY.item.skill.specialization}}</label>
        <input class="item-field-value" type="text"
               name="system.specialization"
               value="{{system.specialization}}"
               data-dtype="String"
               placeholder="{{ANARCHY.item.skill.specializationHelp}}"/>
      </div>
    {{/unless}}

    {{> 'systems/mwd/templates/item/parts/inactive.hbs'}}
    {{> 'systems/mwd/templates/item/parts/references.hbs'}}
  </section>
</div>

