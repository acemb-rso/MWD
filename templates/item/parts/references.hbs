  <div class="form-group">
    <label for="sourceReference">{{ANARCHY.common.sourceReference}} </label>
    <input class="item-field-value" type="text" data-dtype="String"
        name="system.sourceReference" value="{{system.sourceReference}}" 
        placeholder="{{ANARCHY.common.sourceReferenceHelp}}"
    />
  </div>
  <div class="section-group form-group">
    <div class="flexcol">
      <span><label>{{ANARCHY.common.description}}</label></span>
      <div class="editor">
        {{editor enrichedDescription
          target="system.description"
          owner=options.owner
          button=true
          editable=options.editable}}
      </div>
    </div>
  </div>

{{#if options.isGM}}
  <div class="section-group form-group">
    <div class="flexcol">
      <span><label>{{ANARCHY.common.gmNotes}}</label></span>
      <div class="editor">
        {{editor enrichedGMNotes
          target="system.gmNotes"
          owner=options.owner
          button=true
          editable=options.editable}}
      </div>
    </div>
  </div>
{{/if}}

