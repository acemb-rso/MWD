{{!--
templates/item/parts/references.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


  <div class="form-group">
    <label for="sourceReference">{{ANARCHY.common.sourceReference}} </label>
    <input class="item-field-value" type="text" data-dtype="String"
        name="system.sourceReference" value="{{system.sourceReference}}" 
        placeholder="{{ANARCHY.common.sourceReferenceHelp}}"
    />
  </div>
  <div class="section-group form-group">
    <div class="flexcol">
      <span><label>{{ANARCHY.common.description}}</label></span>
      <div class="editor">
        {{editor enrichedDescription
          target="system.description"
          engine="prosemirror"
          collaborate=false
          owner=options.owner
          button=true
          editable=options.editable}}
      </div>
    </div>
  </div>

{{#if options.isGM}}
  <div class="section-group form-group">
    <div class="flexcol">
      <span><label>{{ANARCHY.common.gmnotes}}</label></span>
      <div class="editor">
        {{editor enrichedGMNotes
          target="system.gmnotes"
          engine="prosemirror"
          collaborate=false
          owner=options.owner
          button=true
          editable=options.editable}}
      </div>
    </div>
  </div>
{{/if}}

