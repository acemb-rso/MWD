{{!--
templates/item/parts/itemname.hbs
Purpose: Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<h1 class="item-name">
  <input
    name="name"
    type="text"
    value="{{@root.data.name}}"
    placeholder="{{label}}"
    dir="ltr"
    spellcheck="false"
    data-text-direction="ltr"
  />
</h1>

