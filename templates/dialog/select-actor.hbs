{{!--
templates/dialog/select-actor.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<form class="anarchy-dialog select-actor">
  <div class="flexcol">
    {{#each actors as |actor key|}}
      <a class="click-select-actor" data-actor-id="{{actor.id}}">
        {{> 'systems/mwd/templates/common/actor-reference.hbs' actor}}
      </a>
    {{/each}}
  </div>
</form>