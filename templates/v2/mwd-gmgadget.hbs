{{!--
templates/v2/mwd-gmgadget.hbs
Purpose: Renders collections with `each` blocks. Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<section class="mwd-gmgadget__root">
  <nav class="mwd-gmgadget__tabs" aria-label="GM Gadget Tools">
    <button
      type="button"
      class="mwd-gmgadget__tab {{#if (eq currentTab 'difficulty')}}is-active{{/if}}"
      data-action="switchTab"
      data-tab="difficulty">
      Difficulty
    </button>
    <button
      type="button"
      class="mwd-gmgadget__tab {{#if (eq currentTab 'harm')}}is-active{{/if}}"
      data-action="switchTab"
      data-tab="harm">
      Harm
    </button>
    <button
      type="button"
      class="mwd-gmgadget__tab {{#if (eq currentTab 'hazard')}}is-active{{/if}}"
      data-action="switchTab"
      data-tab="hazard">
      Hazards
    </button>
    <button
      type="button"
      class="mwd-gmgadget__tab {{#if (eq currentTab 'scene')}}is-active{{/if}}"
      data-action="switchTab"
      data-tab="scene">
      Scene
    </button>
  </nav>

  <div class="mwd-gmgadget__panel">
    {{#if (eq currentTab "difficulty")}}
      <section class="mwd-gmgadget__section">
        <header class="mwd-gmgadget__header">
          <div><b>Next Roll Difficulty</b></div>
          <div class="mwd-gmgadget__sub">DN = hits needed</div>
        </header>

        <div class="mwd-gmgadget__current">
          <span>Current:</span>
          <b>DN {{currentDn}}</b>
          <a class="mwd-gmgadget__clear" data-action="clearDn">Reset</a>
        </div>

        <div class="mwd-gmgadget__bar">
          {{#each presets as |p|}}
            <button
              type="button"
              class="mwd-gmgadget__btn {{#if (eq ../currentDn p.dn)}}is-active{{/if}}"
              data-action="setDn"
              data-dn="{{p.dn}}"
              data-label="{{p.label}}"
              title="Set next roll DN to {{p.dn}}">
              {{p.label}} ({{p.dn}})
            </button>
          {{/each}}
        </div>

        <footer class="mwd-gmgadget__footer">
          <label class="mwd-gmgadget__toggle">
            <input type="checkbox" {{#if announce}}checked{{/if}} data-action="toggleAnnounce" />
            Announce to chat
          </label>
        </footer>
      </section>
    {{/if}}

    {{#if (eq currentTab "harm")}}
      <section class="mwd-gmgadget__section mwd-gmgadget__section--harm">
        <header class="mwd-gmgadget__header">
          <div><b>GM Harm</b></div>
          <div class="mwd-gmgadget__sub">Direct adjudication for character harm and recovery</div>
        </header>

        <div class="mwd-gmgadget__target-block">
          <div class="mwd-gmgadget__target-row">
            <div>
              <div class="mwd-gmgadget__field-label">Scene Target</div>
              <div class="mwd-gmgadget__target-value">{{harm.sceneTarget.label}}</div>
              {{#if harm.sceneTarget.reason}}
                <div class="mwd-gmgadget__hint">{{harm.sceneTarget.reason}}</div>
              {{/if}}
            </div>
            <button type="button" class="mwd-gmgadget__mini-btn" data-action="refreshHarmTarget">Refresh</button>
          </div>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Actor Fallback</span>
            <select name="harm-actorId" data-action="harmInputChange" data-harm-key="actorId">
              <option value="">Select character...</option>
              {{#each harm.actorOptions as |actor|}}
                <option value="{{actor.id}}" {{#if (eq ../harm.state.actorId actor.id)}}selected{{/if}}>{{actor.name}}</option>
              {{/each}}
            </select>
          </label>

          <div class="mwd-gmgadget__target-summary">
            <span class="mwd-gmgadget__field-label">Effective Target</span>
            <strong>{{harm.effectiveTarget.label}}</strong>
            {{#if harm.effectiveTarget.source}}
              <span class="mwd-gmgadget__pill">{{harm.effectiveTarget.source}}</span>
            {{/if}}
          </div>
        </div>

        <div class="mwd-gmgadget__grid">
          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Operation</span>
            <select name="harm-mode" data-action="harmInputChange" data-harm-key="mode">
              {{#each harm.modes as |mode|}}
                <option value="{{mode.value}}" {{#if (eq ../harm.state.mode mode.value)}}selected{{/if}}>{{mode.label}}</option>
              {{/each}}
            </select>
          </label>

          {{#if harm.showDeltaFields}}
            <label class="mwd-gmgadget__field">
              <span class="mwd-gmgadget__field-label">Delta</span>
              <input
                type="number"
                name="harm-delta"
                value="{{harm.state.delta}}"
                data-action="harmInputChange"
                data-harm-key="delta" />
            </label>
          {{/if}}

          {{#if harm.useArmorAvailable}}
            <label class="mwd-gmgadget__toggle mwd-gmgadget__toggle--field">
              <input
                type="checkbox"
                name="harm-useArmor"
                {{#if harm.state.useArmor}}checked{{/if}}
                data-action="harmInputChange"
                data-harm-key="useArmor" />
              Use armor mitigation
            </label>
          {{/if}}

          {{#if harm.showDamageType}}
            <label class="mwd-gmgadget__field">
              <span class="mwd-gmgadget__field-label">Damage Type</span>
              <select name="harm-damageType" data-action="harmInputChange" data-harm-key="damageType">
                {{#each harm.damageTypes as |type|}}
                  <option value="{{type.value}}" {{#if (eq ../harm.state.damageType type.value)}}selected{{/if}}>{{type.label}}</option>
                {{/each}}
              </select>
            </label>
          {{/if}}

          {{#if harm.showStatusFields}}
            <label class="mwd-gmgadget__field">
              <span class="mwd-gmgadget__field-label">Status</span>
              <select name="harm-statusId" data-action="harmInputChange" data-harm-key="statusId">
                {{#each harm.statusOptions as |status|}}
                  <option value="{{status.value}}" {{#if (eq ../harm.state.statusId status.value)}}selected{{/if}}>
                    {{status.label}}{{#if status.active}} (active){{/if}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="mwd-gmgadget__field">
              <span class="mwd-gmgadget__field-label">Action</span>
              <select name="harm-statusActive" data-action="harmInputChange" data-harm-key="statusActive">
                <option value="add" {{#if harm.state.statusActive}}selected{{/if}}>Apply</option>
                <option value="remove" {{#unless harm.state.statusActive}}selected{{/unless}}>Remove</option>
              </select>
            </label>
          {{/if}}
        </div>

        <label class="mwd-gmgadget__field">
          <span class="mwd-gmgadget__field-label">Source</span>
          <input
            type="text"
            name="harm-source"
            value="{{harm.state.source}}"
            placeholder="Forced march, poison, hazard..."
            data-action="harmInputChange"
            data-harm-key="source" />
        </label>

        <label class="mwd-gmgadget__field">
          <span class="mwd-gmgadget__field-label">Notes</span>
          <textarea
            name="harm-notes"
            rows="3"
            placeholder="Optional notes"
            data-action="harmInputChange"
            data-harm-key="notes">{{harm.state.notes}}</textarea>
        </label>

        {{#if harm.applyReason}}
          <div class="mwd-gmgadget__hint">{{harm.applyReason}}</div>
        {{/if}}

        <footer class="mwd-gmgadget__footer">
          <button
            type="button"
            class="mwd-gmgadget__btn mwd-gmgadget__btn--apply"
            data-action="applyHarm"
            {{#unless harm.canApply}}disabled{{/unless}}>
            Apply Harm
          </button>
        </footer>
      </section>
    {{/if}}

    {{#if (eq currentTab "hazard")}}
      <section class="mwd-gmgadget__section mwd-gmgadget__section--hazard">
        <header class="mwd-gmgadget__header">
          <div><b>Hazard Creator</b></div>
          <div class="mwd-gmgadget__sub">Turn a selected Region from Measured Template Mode into a persistent hazard</div>
        </header>

        <div class="mwd-gmgadget__target-block">
          <div class="mwd-gmgadget__target-row">
            <div>
              <div class="mwd-gmgadget__field-label">Selected Region</div>
              <div class="mwd-gmgadget__target-value">{{hazard.template.label}}</div>
              {{#if hazard.template.reason}}
                <div class="mwd-gmgadget__hint">{{hazard.template.reason}}</div>
              {{/if}}
            </div>
            <button type="button" class="mwd-gmgadget__mini-btn" data-action="refreshHazardTemplate">Refresh</button>
          </div>
        </div>

        <div class="mwd-gmgadget__grid">
          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Label</span>
            <input type="text" name="hazard-label" value="{{hazard.state.label}}" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Color</span>
            <input type="color" name="hazard-color" value="{{hazard.state.color}}" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Start Exposure</span>
            <select name="hazard-startExposure" data-action="hazardInputChange">
              {{#each hazard.exposureTiers as |tier|}}
                <option value="{{tier.value}}" {{#if (eq ../hazard.state.startExposure tier.value)}}selected{{/if}}>{{tier.label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Escalation Rate</span>
            <input type="number" name="hazard-escalationRate" value="{{hazard.state.escalationRate}}" min="0" step="1" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Interval (turns)</span>
            <input type="number" name="hazard-escalationIntervalTurns" value="{{hazard.state.escalationIntervalTurns}}" min="1" step="1" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Max Exposure</span>
            <select name="hazard-escalationMax" data-action="hazardInputChange">
              {{#each hazard.exposureTiers as |tier|}}
                <option value="{{tier.value}}" {{#if (eq ../hazard.state.escalationMax tier.value)}}selected{{/if}}>{{tier.label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Base Damage</span>
            <input type="number" name="hazard-damage" value="{{hazard.state.damage}}" min="0" step="1" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">AP</span>
            <input type="number" name="hazard-ap" value="{{hazard.state.ap}}" min="0" step="1" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Damage Type</span>
            <select name="hazard-damageType" data-action="hazardInputChange">
              {{#each hazard.damageTypes as |type|}}
                <option value="{{type.value}}" {{#if (eq ../hazard.state.damageType type.value)}}selected{{/if}}>{{type.label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="mwd-gmgadget__field">
            <span class="mwd-gmgadget__field-label">Burn at Full</span>
            <input type="number" name="hazard-onFullBurnDelta" value="{{hazard.state.onFullBurnDelta}}" min="0" step="1" data-action="hazardInputChange" />
          </label>

          <label class="mwd-gmgadget__toggle mwd-gmgadget__toggle--field">
            <input type="checkbox" name="hazard-clearOnExit" {{#if hazard.state.clearOnExit}}checked{{/if}} data-action="hazardInputChange" />
            Clear when target exits
          </label>
        </div>

        {{#if hazard.createReason}}
          <div class="mwd-gmgadget__hint">{{hazard.createReason}}</div>
        {{/if}}

        <footer class="mwd-gmgadget__footer">
          <button
            type="button"
            class="mwd-gmgadget__btn mwd-gmgadget__btn--apply"
            data-action="createHazard"
            {{#unless hazard.canCreate}}disabled{{/unless}}>
            Create Hazard Region
          </button>
        </footer>
      </section>
    {{/if}}

    {{#if (eq currentTab "scene")}}
      <section class="mwd-gmgadget__section mwd-gmgadget__section--scene">
        <header class="mwd-gmgadget__header">
          <div><b>Scene Modifiers</b></div>
          <div class="mwd-gmgadget__sub">Environmental and contextual roll modifiers for this scene</div>
        </header>

        {{#unless scene.hasScene}}
          <div class="mwd-gmgadget__hint">No active scene. Load a scene to manage scene modifiers.</div>
        {{else}}

          {{!-- Active Modifiers List --}}
          <div class="mwd-gmgadget__scene-list">
            {{#if scene.activeModifiers.length}}
              {{#each scene.activeModifiers as |mod|}}
                <div class="mwd-gmgadget__scene-row {{#unless mod.enabled}}is-disabled{{/unless}}">
                  <button
                    type="button"
                    class="mwd-gmgadget__scene-toggle"
                    data-action="toggleSceneModifier"
                    data-mod-id="{{mod.id}}"
                    title="{{#if mod.enabled}}Disable{{else}}Enable{{/if}} modifier">
                    {{#if mod.enabled}}●{{else}}○{{/if}}
                  </button>
                  <span class="mwd-gmgadget__scene-label">{{mod.label}}</span>
                  <span class="mwd-gmgadget__scene-value {{#if mod.isPositive}}is-positive{{else}}is-negative{{/if}}">
                    {{mod.signedValue}}
                  </span>
                  <span class="mwd-gmgadget__scene-filters">
                    {{#if mod.attributeFilterLabel}}
                      <span class="mwd-gmgadget__pill">{{mod.attributeFilterLabel}}</span>
                    {{/if}}
                    {{#if mod.intentFilterLabel}}
                      <span class="mwd-gmgadget__pill">{{mod.intentFilterLabel}}</span>
                    {{/if}}
                    {{#if mod.source}}
                      <span class="mwd-gmgadget__pill mwd-gmgadget__pill--source">
                        {{#if (eq mod.source "preset")}}Preset{{else}}Custom{{/if}}
                      </span>
                    {{/if}}
                  </span>
                  <button
                    type="button"
                    class="mwd-gmgadget__scene-delete"
                    data-action="removeSceneModifier"
                    data-mod-id="{{mod.id}}"
                    title="Remove modifier">✕</button>
                </div>
              {{/each}}
            {{else}}
              <div class="mwd-gmgadget__hint">No scene modifiers active.</div>
            {{/if}}
          </div>

          {{!-- Add from Preset --}}
          <div class="mwd-gmgadget__scene-add-block">
            <div class="mwd-gmgadget__field-label">Add from Preset</div>
            {{#if scene.templates.length}}
              <div class="mwd-gmgadget__scene-preset-row">
                <select name="scene-preset-index" class="mwd-gmgadget__scene-preset-select">
                  {{#each scene.templates as |t|}}
                    <option value="{{t.index}}">
                      {{t.label}} ({{t.signedValue}}{{#if t.attributeFilter}} · {{t.attributeFilter}}{{/if}}{{#if t.intentFilter}} · {{t.intentFilter}}{{/if}})
                    </option>
                  {{/each}}
                </select>
                <button
                  type="button"
                  class="mwd-gmgadget__mini-btn"
                  data-action="addSceneModifierFromPreset">
                  Add
                </button>
              </div>
            {{else}}
              <div class="mwd-gmgadget__hint">No templates configured. Add some in Settings → Scene Modifier Templates.</div>
            {{/if}}
          </div>

          {{!-- Add Custom --}}
          <div class="mwd-gmgadget__scene-add-block">
            <div class="mwd-gmgadget__field-label">Add Custom</div>
            <div class="mwd-gmgadget__grid">
              <label class="mwd-gmgadget__field">
                <span class="mwd-gmgadget__field-label">Label</span>
                <input type="text" name="scene-adhoc-label" placeholder="Darkness, Rain..." />
              </label>
              <label class="mwd-gmgadget__field">
                <span class="mwd-gmgadget__field-label">Value</span>
                <input type="number" name="scene-adhoc-value" value="0" step="1" />
              </label>
              <label class="mwd-gmgadget__field">
                <span class="mwd-gmgadget__field-label">Attribute</span>
                <select name="scene-adhoc-attributeFilter">
                  {{#each scene.attributeFilterOptions as |opt|}}
                    <option value="{{opt.value}}">{{opt.label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="mwd-gmgadget__field">
                <span class="mwd-gmgadget__field-label">Intent</span>
                <select name="scene-adhoc-intentFilter">
                  {{#each scene.intentFilterOptions as |opt|}}
                    <option value="{{opt.value}}">{{opt.label}}</option>
                  {{/each}}
                </select>
              </label>
            </div>
            <button
              type="button"
              class="mwd-gmgadget__mini-btn"
              data-action="addSceneModifierAdhoc">
              Add Custom
            </button>
          </div>

          <footer class="mwd-gmgadget__footer">
            <button
              type="button"
              class="mwd-gmgadget__btn mwd-gmgadget__btn--danger"
              data-action="clearSceneModifiers"
              {{#unless scene.activeModifiers.length}}disabled{{/unless}}>
              Clear All Modifiers
            </button>
          </footer>

        {{/unless}}
      </section>
    {{/if}}
  </div>
</section>
