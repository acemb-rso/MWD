{{!--
templates/v2/item/armor.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="{{cssClass}}">
<header class="sheet-header">
  <img class="anarchy-img profile-img" src="{{item.img}}" data-action="editImage" data-tooltip="{{item.name}}"/>
  {{> 'systems/mwd/templates/v2/item/parts/itemname.hbs'
    label=MWD.itemType.singular.armor
  }}
</header>

<nav class="sheet-tabs tabs" data-group="primary" data-default="main">
  <div class="sheet-tab" data-tab="main">
    <a>{{tabs.main.label}}</a>
  </div>
  <div class="sheet-tab" data-tab="modifiers">
    <a>{{tabs.modifiers.label}}</a>
  </div>
  <div class="sheet-tab-fill"></div>
</nav>

<section class="sheet-body">
  <div class="tab section-group" data-group="primary" data-tab="main">
    {{#if itemSheet.canUseActorControls}}
      <div class="form-group">
        {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--inline" label=MWD.item.armor.equipped}}
          <input type="checkbox" name="system.equipped" {{checked system.equipped}} />
        {{/ "mwd.v2.components.checkbox"}}
      </div>

      <div class="form-group">
        {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--inline" label=MWD.item.armor.primary}}
          <input type="checkbox" name="system.isPrimary" {{checked system.isPrimary}} />
        {{/ "mwd.v2.components.checkbox"}}
      </div>
    {{else}}
      <p class="notes">Equip and primary controls become available when this armor is embedded in an actor.</p>
    {{/if}}

    <div class="form-group">
      <label for="system.rating">{{MWD.item.armor.rating}}</label>
      <input class="type-numeric" type="number" name="system.rating" value="{{system.rating}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label for="system.defenseBonus">{{MWD.item.armor.defenseBonus}}</label>
      <input class="type-numeric" type="number" name="system.defenseBonus" value="{{system.defenseBonus}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label>{{MWD.item.armor.durability}}</label>
      <div class="flexrow flex-wrap">
        <input class="type-numeric" type="number" name="system.durability.current" value="{{effectiveDurabilityCurrent}}" data-dtype="Number" />
        <span>/</span>
        <input class="type-numeric" type="number" name="system.durability.max" value="{{system.durability.max}}" data-dtype="Number" />
      </div>
      {{#if isActiveArmor}}
        <p class="notes">Resistance uses the armor rating, durability is spent with each use, and the effective rating only drops if durability falls below the rating.</p>
      {{/if}}
    </div>

    <h3>{{MWD.item.armor.mitigation}}</h3>

    <div class="form-group">
      <label for="system.mitigationByType.penetrating">Penetrating</label>
      <input class="type-numeric" type="number" name="system.mitigationByType.penetrating" value="{{system.mitigationByType.penetrating}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label for="system.mitigationByType.concussive">Concussive</label>
      <input class="type-numeric" type="number" name="system.mitigationByType.concussive" value="{{system.mitigationByType.concussive}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label for="system.mitigationByType.energy">Energy</label>
      <input class="type-numeric" type="number" name="system.mitigationByType.energy" value="{{system.mitigationByType.energy}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label for="system.mitigationByType.thermal">Thermal</label>
      <input class="type-numeric" type="number" name="system.mitigationByType.thermal" value="{{system.mitigationByType.thermal}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label for="system.mitigationByType.electrical">Electrical</label>
      <input class="type-numeric" type="number" name="system.mitigationByType.electrical" value="{{system.mitigationByType.electrical}}" data-dtype="Number" />
    </div>

    <div class="form-group">
      <label for="system.tags">{{MWD.item.armor.tags}}</label>
      <input type="text" name="system.tags" value="{{join system.tags ', '}}" />
    </div>

    <div class="form-group">
      <label for="system.traits">{{MWD.item.armor.traits}}</label>
      <input type="text" name="system.traits" value="{{join system.traits ', '}}" />
    </div>

    <div class="form-group stacked">
      <label for="system.notes">{{MWD.item.armor.notes}}</label>
      <textarea name="system.notes">{{system.notes}}</textarea>
    </div>

    {{> 'systems/mwd/templates/v2/item/parts/references.hbs'}}
  </div>

  <div class="tab section-group" data-group="primary" data-tab="modifiers">
    {{> 'systems/mwd/templates/v2/item/parts/modifiers.hbs'}}
  </div>
</section>
</div>
