{{!--
templates/v2/item/quality.hbs
Purpose: Structured authoring UI for quality-backed traits.
How it fits: Lets quality items remain authored content while the engine reads declarative rule packets.
--}}

<section class="{{cssClass}} mwd-sheet mwd-item-sheet mwd-item-sheet--quality" data-application-part="sheet">
  <header class="sheet-header">
    <div class="header-left">
      <div class="mwd-item-sheet__media">
        <img class="profile" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-tooltip="{{item.name}}" />
      </div>

      <div class="mwd-item-sheet__meta">
        <div class="mwd-item-sheet__eyebrow">{{itemSheet.typeLabel}}</div>
        {{> "mwd.v2.item.parts.itemname" label=itemSheet.typeLabel}}

        {{#if itemSheet.summaryChips.length}}
          <div class="mwd-item-sheet__summary">
            {{#each itemSheet.summaryChips as |chip|}}
              <span class="chip mwd-item-sheet__summary-chip">
                <strong>{{chip.label}}</strong>
                {{#if chip.value}}
                  <span>{{chip.value}}</span>
                {{/if}}
              </span>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </div>

    {{#if itemSheet.stateChips.length}}
      <div class="header-right">
        <div class="mwd-item-sheet__state">
          {{#each itemSheet.stateChips as |chip|}}
            <span class="chip mwd-item-sheet__state-chip{{#if chip.tone}} is-{{chip.tone}}{{/if}}">{{chip.label}}</span>
          {{/each}}
        </div>
      </div>
    {{/if}}
  </header>

  <section class="sheet-body">
    <div class="section-group">

    {{> 'systems/mwd/templates/v2/item/parts/inactive.hbs'}}

    <div class="mwd-two-col">
      <div class="form-group">
        <label for="system.category" data-tooltip="Positive: a trait that benefits the character. Negative: a drawback or limitation. Narrative: story-only — the engine applies no mechanical effects.">Category</label>
        <select name="system.category">
          {{selectOptions traitEditor.categories selected=system.category valueAttr="value" labelAttr="label" localize=false}}
        </select>
      </div>

      <div class="form-group">
        <label for="system.tier" data-tooltip="Minor: a smaller benefit or drawback (1 build point). Major: a significant benefit or drawback (2 build points).">Tier</label>
        <select name="system.tier">
          {{selectOptions traitEditor.tiers selected=system.tier valueAttr="value" labelAttr="label" localize=false}}
        </select>
      </div>

      <div class="form-group">
        <label for="system.activation" data-tooltip="Passive: the trait is always active — the engine applies it automatically when conditions are met. Triggered: the trait only applies when a player or game event explicitly activates it.">Activation</label>
        <select name="system.activation">
          {{selectOptions traitEditor.activations selected=system.activation valueAttr="value" labelAttr="label" localize=false}}
        </select>
      </div>

      <div class="form-group">
        <label for="system.tags" data-tooltip="Comma-separated keywords, e.g. combat, burn, narrative. Tags help categorise this trait for filtering and display. Leave blank if unused.">Tags</label>
        <input type="text" name="system.tags" value="{{tagsText}}" placeholder="combat, burn, narrative" />
      </div>
    </div>

    <div class="mwd-record mwd-record--embedded">
      <div class="mwd-record__header">
        <div class="mwd-record__main">
          <div class="mwd-record__topline">
            <span class="mwd-record__title-btn">Trait Limits</span>
          </div>
          <div class="mwd-record__subtitle">Optional shared usage limits. Effect-level limits take precedence when set — these only apply to effects with no limit of their own. Leave at 0 for unlimited.</div>
        </div>
      </div>
      <div class="mwd-record__body">
        <div class="mwd-three-col">
          <div class="form-group">
            <label for="system.limits.perActivation" data-tooltip="Maximum times any effect on this trait may fire within one character activation. Resets at the start of each activation. 0 = no limit.">Per Activation</label>
            <input class="type-numeric" type="number" min="0" step="1" name="system.limits.perActivation" value="{{system.limits.perActivation}}" />
          </div>
          <div class="form-group">
            <label for="system.limits.perRound" data-tooltip="Maximum times any effect on this trait may fire per combat round. Resets when the round advances. 0 = no limit.">Per Round</label>
            <input class="type-numeric" type="number" min="0" step="1" name="system.limits.perRound" value="{{system.limits.perRound}}" />
          </div>
          <div class="form-group">
            <label for="system.limits.perScene" data-tooltip="Maximum times any effect on this trait may fire per scene. Persists across rounds until the scene changes. 0 = no limit.">Per Scene</label>
            <input class="type-numeric" type="number" min="0" step="1" name="system.limits.perScene" value="{{system.limits.perScene}}" />
          </div>
        </div>
      </div>
    </div>

    <div class="mwd-record mwd-record--embedded">
      <div class="mwd-record__header">
        <div class="mwd-record__main">
          <div class="mwd-record__topline">
            <span class="mwd-record__title-btn">Prerequisites</span>
          </div>
          <div class="mwd-record__subtitle">Trait-wide conditions checked before any effect fires. All must pass. Uses dotted fact paths to read engine state — see the reference below.</div>
        </div>
        <div class="mwd-record__actions">
          <button type="button" class="mwd-record__icon-btn mwd-quality-prereq-add" title="Add prerequisite">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="mwd-record__body">
        <div class="mwd-item-note">
          <strong>Fact reference:</strong>
          <code>activation.moved</code> (bool) &nbsp;·&nbsp;
          <code>activation.attacksThisActivation</code> (num) &nbsp;·&nbsp;
          <code>activation.saSpent</code> (num) &nbsp;·&nbsp;
          <code>burn.current</code> (num) &nbsp;·&nbsp;
          <code>burn.overloaded</code> (bool) &nbsp;·&nbsp;
          <code>timing.firstAttackThisActivation</code> (bool) &nbsp;·&nbsp;
          <code>intent</code> (string: attack, skill…) &nbsp;·&nbsp;
          <code>rangeBand</code> (string: close, near, far, extreme) &nbsp;·&nbsp;
          <code>edge.spent</code> (bool)
        </div>
        {{#if system.prerequisites.length}}
          <div class="mwd-records">
            {{#each system.prerequisites as |prereq|}}
              <div class="mwd-weapon-compact__row mwd-weapon-compact__row--actions" data-prereq-id="{{prereq.id}}">
                <div class="form-group">
                  <label data-tooltip="A dotted path into the engine fact object, e.g. activation.moved or burn.current. See the fact reference above for available paths.">Fact</label>
                  <input class="mwd-quality-prereq-field" type="text" value="{{prereq.fact}}" data-prereq-id="{{prereq.id}}" data-field="fact" placeholder="activation.moved" />
                </div>
                <div class="form-group">
                  <label data-tooltip="How to compare the fact to the value. Use 'Is True' or 'Is False' for boolean checks — no Value needed. Use = for exact match.">Comparator</label>
                  <select class="mwd-quality-prereq-field" data-prereq-id="{{prereq.id}}" data-field="comparator">
                    {{selectOptions ../traitEditor.comparators selected=prereq.comparator valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>
                <div class="form-group">
                  <label data-tooltip="The value to compare against. Auto-typed: 'true'/'false' become booleans, plain numbers become numerics, anything else is a string. Leave blank when using 'Is True' or 'Is False'.">Value</label>
                  <input class="mwd-quality-prereq-field" type="text" value="{{prereq.value}}" data-prereq-id="{{prereq.id}}" data-field="value" placeholder="false, 3, grit" />
                </div>
                <button type="button" class="mwd-record__icon-btn is-danger mwd-quality-prereq-delete" data-prereq-id="{{prereq.id}}" title="Remove prerequisite">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="mwd-item-note">No prerequisites defined — all effects will fire whenever their phase and selector match.</div>
        {{/if}}
      </div>
    </div>

    <div class="mwd-record mwd-record--embedded">
      <div class="mwd-record__header">
        <div class="mwd-record__main">
          <div class="mwd-record__topline">
            <span class="mwd-record__title-btn">Effects</span>
          </div>
          <div class="mwd-record__subtitle">Rule packets consumed by the engine at specific pipeline phases. Each effect fires independently. A trait with no effects is descriptive only.</div>
        </div>
        <div class="mwd-record__actions">
          <button type="button" class="mwd-record__icon-btn mwd-quality-effect-add" title="Add effect">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="mwd-record__body">
        {{#if system.effects.length}}
          <div class="mwd-records">
            {{#each system.effects as |effect|}}
              <div class="mwd-record is-expanded" data-effect-id="{{effect.id}}">
                <div class="mwd-record__header">
                  <div class="mwd-record__main">
                    <div class="mwd-record__topline">
                      <span class="mwd-record__title-btn">{{#if effect.label}}{{effect.label}}{{else}}Effect{{/if}}</span>
                      <div class="mwd-record__stats">
                        <span class="mwd-record__stat">
                          <span class="mwd-record__stat-label">Type</span>
                          <span class="mwd-record__stat-value">{{effect.type}}</span>
                        </span>
                        <span class="mwd-record__stat">
                          <span class="mwd-record__stat-label">Phase</span>
                          <span class="mwd-record__stat-value">{{effect.phase}}</span>
                        </span>
                      </div>
                    </div>
                    {{#if effect.selector}}
                      <div class="mwd-record__subtitle">{{effect.selector}}</div>
                    {{/if}}
                  </div>
                  <div class="mwd-record__actions">
                    <button type="button" class="mwd-record__icon-btn is-danger mwd-quality-effect-delete" data-effect-id="{{effect.id}}" title="Delete effect">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                </div>
                <div class="mwd-record__body">
                  <div class="mwd-two-col">
                    <div class="form-group">
                      <label data-tooltip="Roll Modifier: adds dice to a roll pool. Burn Adjust: modifies burn cost or amount. Action Cost Mod: modifies action point cost. Initiative Mod: modifies initiative total. Damage Intake Mod: modifies damage received. Edge Event: adjusts edge gained/spent, or grants an edge pool at end of activation.">Type</label>
                      <select class="mwd-quality-effect-field" data-effect-id="{{effect.id}}" data-field="type">
                        {{selectOptions ../traitEditor.effectTypes selected=effect.type valueAttr="value" labelAttr="label" localize=false}}
                      </select>
                    </div>
                    <div class="form-group">
                      <label data-tooltip="When in the engine pipeline this effect fires. Match to the Type: Build Roll for dice mods · Before Burn Applied for burn · Before Action Cost Finalized for AP cost · Initiative Resolved for initiative · Damage Resolved for damage intake · End of Activation for cleanup · Edge Spend/Gain for edge events.">Phase</label>
                      <select class="mwd-quality-effect-field" data-effect-id="{{effect.id}}" data-field="phase">
                        {{selectOptions ../traitEditor.phases selected=effect.phase valueAttr="value" labelAttr="label" localize=false}}
                      </select>
                    </div>
                    <div class="form-group">
                      <label data-tooltip="Shown in roll breakdowns and modifier summaries. Defaults to the trait name if left blank.">Label</label>
                      <input class="mwd-quality-effect-field" type="text" value="{{effect.label}}" data-effect-id="{{effect.id}}" data-field="label" placeholder="Marksman" />
                    </div>
                    <div class="form-group">
                      <label data-tooltip="Restricts this effect to specific roll intents or domains. Leave blank to match all rolls in this phase. Examples: intent.attack · intent.skill · domain.combat · range.close · range.near · edge.pre. Uses prefix matching — 'intent' matches intent.attack, intent.skill, etc.">Selector</label>
                      <input class="mwd-quality-effect-field" type="text" value="{{effect.selector}}" data-effect-id="{{effect.id}}" data-field="selector" placeholder="intent.attack" />
                    </div>
                  </div>

                  <div class="mwd-three-col">
                    <div class="form-group">
                      <label data-tooltip="The numeric modifier applied by this effect. Added to the dice pool (Roll Modifier), burn amount (Burn Adjust), action point cost, initiative total, or damage as appropriate for the Type. Use negative numbers to reduce.">Value</label>
                      <input class="type-numeric mwd-quality-effect-field" type="number" step="1" value="{{effect.value}}" data-effect-id="{{effect.id}}" data-field="value" />
                    </div>
                    <div class="form-group">
                      <label data-tooltip="Optional floor: the result cannot go below this after applying Value. Leave blank for no minimum.">Min</label>
                      <input class="type-numeric mwd-quality-effect-field" type="number" step="1" value="{{effect.min}}" data-effect-id="{{effect.id}}" data-field="min" />
                    </div>
                    <div class="form-group">
                      <label data-tooltip="Optional ceiling: the result cannot go above this after applying Value. Leave blank for no maximum.">Max</label>
                      <input class="type-numeric mwd-quality-effect-field" type="number" step="1" value="{{effect.max}}" data-effect-id="{{effect.id}}" data-field="max" />
                    </div>
                  </div>

                  <div class="mwd-three-col">
                    <div class="form-group">
                      <label data-tooltip="Edge pool to target. Only used by Edge Event effects with the 'Grant Pool' operation. Valid keys: grit · chaos · insight · legend.">Pool</label>
                      <input class="mwd-quality-effect-field" type="text" value="{{effect.pool}}" data-effect-id="{{effect.id}}" data-field="pool" placeholder="grit" />
                    </div>
                    <div class="form-group">
                      <label data-tooltip="Edge Event only. Adjust Amount: modifies the edge amount being gained or spent by Value. Grant Pool: adds Value to the named Pool at end of activation.">Edge Operation</label>
                      <select class="mwd-quality-effect-field" data-effect-id="{{effect.id}}" data-field="operation">
                        {{selectOptions ../traitEditor.edgeOperations selected=effect.operation valueAttr="value" labelAttr="label" localize=false}}
                      </select>
                    </div>
                    <div class="form-group">
                      <label data-tooltip="How many times this effect may fire within one character activation. Overrides the trait-level limit when set. 0 = no limit.">Per Activation</label>
                      <input class="type-numeric mwd-quality-effect-field" type="number" min="0" step="1" value="{{effect.limit.perActivation}}" data-effect-id="{{effect.id}}" data-field="limit.perActivation" />
                    </div>
                    <div class="form-group">
                      <label data-tooltip="How many times this effect may fire per combat round. Overrides the trait-level limit when set. 0 = no limit.">Per Round</label>
                      <input class="type-numeric mwd-quality-effect-field" type="number" min="0" step="1" value="{{effect.limit.perRound}}" data-effect-id="{{effect.id}}" data-field="limit.perRound" />
                    </div>
                    <div class="form-group">
                      <label data-tooltip="How many times this effect may fire per scene. Overrides the trait-level limit when set. 0 = no limit.">Per Scene</label>
                      <input class="type-numeric mwd-quality-effect-field" type="number" min="0" step="1" value="{{effect.limit.perScene}}" data-effect-id="{{effect.id}}" data-field="limit.perScene" />
                    </div>
                  </div>

                  <div class="mwd-record mwd-record--embedded">
                    <div class="mwd-record__header">
                      <div class="mwd-record__main">
                        <div class="mwd-record__topline">
                          <span class="mwd-record__title-btn">Conditions</span>
                        </div>
                        <div class="mwd-record__subtitle">Per-effect fact checks in addition to trait prerequisites. All must pass for this effect to fire. Uses the same fact paths.</div>
                      </div>
                      <div class="mwd-record__actions">
                        <button type="button"
                                class="mwd-record__icon-btn mwd-quality-effect-condition-add"
                                data-effect-id="{{effect.id}}"
                                title="Add condition">
                          <i class="fas fa-plus"></i>
                        </button>
                      </div>
                    </div>
                    <div class="mwd-record__body">
                      {{#if effect.conditions.length}}
                        <div class="mwd-records">
                          {{#each effect.conditions as |condition|}}
                            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--actions" data-condition-id="{{condition.id}}">
                              <div class="form-group">
                                <label data-tooltip="A dotted path into the engine fact object. Same paths as Prerequisites: activation.moved, burn.current, intent, rangeBand, edge.spent, etc.">Fact</label>
                                <input class="mwd-quality-effect-condition-field"
                                       type="text"
                                       value="{{condition.fact}}"
                                       data-effect-id="{{../id}}"
                                       data-condition-id="{{condition.id}}"
                                       data-field="fact"
                                       placeholder="burn.current" />
                              </div>
                              <div class="form-group">
                                <label data-tooltip="How to compare the fact to the value. Use 'Is True' or 'Is False' for boolean checks — no Value needed.">Comparator</label>
                                <select class="mwd-quality-effect-condition-field"
                                        data-effect-id="{{../id}}"
                                        data-condition-id="{{condition.id}}"
                                        data-field="comparator">
                                  {{selectOptions ../../traitEditor.comparators selected=condition.comparator valueAttr="value" labelAttr="label" localize=false}}
                                </select>
                              </div>
                              <div class="form-group">
                                <label data-tooltip="Auto-typed: 'true'/'false' become booleans, plain numbers become numerics. Leave blank for 'Is True' / 'Is False'.">Value</label>
                                <input class="mwd-quality-effect-condition-field"
                                       type="text"
                                       value="{{condition.value}}"
                                       data-effect-id="{{../id}}"
                                       data-condition-id="{{condition.id}}"
                                       data-field="value"
                                       placeholder="3, false, grit" />
                              </div>
                              <button type="button"
                                      class="mwd-record__icon-btn is-danger mwd-quality-effect-condition-delete"
                                      data-effect-id="{{../id}}"
                                      data-condition-id="{{condition.id}}"
                                      title="Remove condition">
                                <i class="fas fa-times"></i>
                              </button>
                            </div>
                          {{/each}}
                        </div>
                      {{else}}
                        <div class="mwd-item-note">No conditions — this effect fires whenever the phase and selector match (and any trait prerequisites pass).</div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="mwd-item-note">No effects defined. This quality is descriptive only until rule packets are added.</div>
        {{/if}}
      </div>
    </div>

    {{> 'systems/mwd/templates/v2/item/parts/references.hbs'}}
  </div>
  </section>
</section>
