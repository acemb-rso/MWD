{{!--
templates/v2/item/parts/asset-module-main.hbs
Purpose: Renders the core authoring controls for Asset Modules.
How it fits: Gives modules a structured payload surface so BattleMech abilities
can be derived from installed modules instead of from sheet-side logic.
--}}

<div class="section-group">
  <div class="form-group">
    <label for="system.category">{{MWD.item.assetModule.category}}</label>
    <select name="system.category" data-dtype="String">
      {{selectOptions ENUMS.assetModuleCategories selected=system.category valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>

  <div class="form-group">
    <label for="system.level">{{MWD.item.assetModule.level}}</label>
    <input class="type-numeric" type="number" name="system.level" value="{{system.level}}" min="1" step="1" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.installClass">Install Class</label>
    <select name="system.installClass" data-dtype="String">
      <option value="module" {{#if (eq system.installClass "module")}}selected{{/if}}>Module</option>
      <option value="equipment" {{#if (eq system.installClass "equipment")}}selected{{/if}}>Equipment</option>
    </select>
  </div>

  <div class="form-group">
    <label for="system.activation.mode">Activation</label>
    <select name="system.activation.mode" data-dtype="String">
      <option value="passive" {{#if (eq system.activation.mode "passive")}}selected{{/if}}>Passive</option>
      <option value="toggle" {{#if (eq system.activation.mode "toggle")}}selected{{/if}}>Toggle</option>
      <option value="mode" {{#if (eq system.activation.mode "mode")}}selected{{/if}}>Mode</option>
      <option value="triggered" {{#if (eq system.activation.mode "triggered")}}selected{{/if}}>Triggered</option>
    </select>
  </div>

  <label class="checkbox">
    <input type="checkbox" name="system.activation.active" {{checked system.activation.active}} />
    Active
  </label>

  <div class="form-group">
    <label for="system.activation.selectedMode">Selected Mode</label>
    <input type="text" name="system.activation.selectedMode" value="{{system.activation.selectedMode}}" data-dtype="String" />
  </div>

  <div class="form-group">
    <label for="system.activation.cooldownUntilRound">Cooldown Until Round</label>
    <input class="type-numeric" type="number" name="system.activation.cooldownUntilRound" value="{{system.activation.cooldownUntilRound}}" min="0" step="1" data-dtype="Number" />
  </div>

  <label class="checkbox">
    <input type="checkbox" name="system.mobility.jumping.enabled" {{checked system.mobility.jumping.enabled}} />
    {{MWD.item.assetModule.jumping.enabled}}
  </label>

  <div class="form-group">
    <label for="system.mobility.jumping.movement">{{MWD.item.assetModule.jumping.movement}}</label>
    <input class="type-numeric" type="number" name="system.mobility.jumping.movement" value="{{system.mobility.jumping.movement}}" min="0" step="1" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mobility.jumping.heat">{{MWD.item.assetModule.jumping.heat}}</label>
    <input class="type-numeric" type="number" name="system.mobility.jumping.heat" value="{{system.mobility.jumping.heat}}" min="0" step="1" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mobility.jumping.attackRatingBonus">{{MWD.item.assetModule.jumping.attackRatingBonus}}</label>
    <input class="type-numeric" type="number" name="system.mobility.jumping.attackRatingBonus" value="{{system.mobility.jumping.attackRatingBonus}}" step="1" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mobility.jumping.defenseRatingBonus">{{MWD.item.assetModule.jumping.defenseRatingBonus}}</label>
    <input class="type-numeric" type="number" name="system.mobility.jumping.defenseRatingBonus" value="{{system.mobility.jumping.defenseRatingBonus}}" step="1" data-dtype="Number" />
  </div>

  <label class="checkbox">
    <input type="checkbox" name="system.mobility.jumping.dfaEnabled" {{checked system.mobility.jumping.dfaEnabled}} />
    {{MWD.item.assetModule.jumping.dfaEnabled}}
  </label>

  <div class="mwd-form-section-label">Cluster Fire Control</div>

  <div class="form-group">
    <label for="system.targeting.clustering.diceModifier">Cluster Dice Mod</label>
    <input class="type-numeric" type="number" name="system.targeting.clustering.diceModifier" value="{{system.targeting.clustering.diceModifier}}" step="1" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.targeting.clustering.targetNumberModifier">Cluster TN Mod</label>
    <input class="type-numeric" type="number" name="system.targeting.clustering.targetNumberModifier" value="{{system.targeting.clustering.targetNumberModifier}}" step="1" data-dtype="Number" />
  </div>

  <div class="mwd-item-note">
    These modifiers apply only to attacks that already have clustering dice. Negative TN mods make clustering hits easier, so an Artemis-style system would usually use <code>-1</code>.
  </div>

  <div class="mwd-form-section-label">Structured Effects JSON</div>

  <div class="form-group stacked">
    <label for="system.effects">Effects</label>
    <textarea name="system.effects" rows="12" spellcheck="false">{{itemSheet.assetModuleEffectsJson}}</textarea>
  </div>

  {{#if itemSheet.assetModuleSummary}}
    <div class="mwd-item-note">{{itemSheet.assetModuleSummary}}</div>
  {{/if}}

  {{#if itemSheet.assetModuleErrors.length}}
    <div class="mwd-item-note is-danger">
      {{#each itemSheet.assetModuleErrors as |error|}}
        <div>{{error}}</div>
      {{/each}}
    </div>
  {{/if}}
</div>
