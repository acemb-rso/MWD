{{!--
templates/v2/item/parts/weapon-notes-reference.hbs
Purpose: Renders notes, description, and auxiliary reference controls for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--full">
  <label for="system.notes">{{MWD.item.personalWeapon.notes}}</label>
  <div class="editor">
    {{formInput fields.notes
      value=system.notes
      enriched=enriched.system.notes
      toggled=true}}
  </div>
</div>

<div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--full">
  <label for="sourceReference">{{MWD.common.sourceReference}}</label>
  <input class="item-field-value" type="text" data-dtype="String"
    name="system.sourceReference"
    value="{{system.sourceReference}}"
    placeholder="{{MWD.common.sourceReferenceHelp}}"
  />
</div>

<div class="section-group form-group mwd-weapon-compact__field mwd-weapon-compact__field--full mwd-weapon-compact__field--references">
  <div class="flexcol">
    <span><label>{{MWD.common.description}}</label></span>
    <div class="editor">
      {{formInput fields.description
        value=system.description
        enriched=enriched.system.description
        toggled=true}}
    </div>
  </div>
</div>
