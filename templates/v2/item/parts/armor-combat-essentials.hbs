{{!--
templates/v2/item/parts/armor-combat-essentials.hbs
Purpose: Renders the core editable protection fields for armor.
How it fits: Used by the CSB-driven armor details layout.
--}}

{{#unless system.battleArmor.enabled}}
  <div class="mwd-item-form-grid mwd-armor-profile-grid">
    <div class="form-group">
      <label for="system.rating">{{MWD.item.armor.rating}}</label>
      <input class="type-numeric" type="number" name="system.rating" value="{{system.rating}}" data-dtype="Number" />
    </div>
  </div>
{{/unless}}

<div class="section-group mwd-battle-armor-editor">
  <div class="mwd-battle-armor-editor__headline">
    <div class="mwd-battle-armor-editor__title">
      <h4>Battle Armor</h4>
      {{#if system.battleArmor.enabled}}
        <span class="mwd-battle-armor-editor__state">{{system.battleArmor.state}}</span>
      {{/if}}
    </div>

    {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card mwd-battle-armor-editor__enabled" label="Enabled"}}
      <input type="checkbox"
             name="system.battleArmor.enabled"
             {{checked system.battleArmor.enabled}} />
    {{/ "mwd.v2.components.checkbox"}}
  </div>

  {{#if system.battleArmor.enabled}}
    <div class="mwd-battle-armor-editor__body">
      <div class="mwd-item-form-grid mwd-armor-profile-grid mwd-battle-armor-editor__metrics">
        <div class="form-group">
          <label>Armor Pool</label>
          <div class="mwd-field-cluster">
            <input class="type-numeric" type="number" name="system.battleArmor.armorPool.value" value="{{system.battleArmor.armorPool.value}}" min="0" step="1" data-dtype="Number" />
            <span>/</span>
            <input class="type-numeric" type="number" name="system.battleArmor.armorPool.max" value="{{system.battleArmor.armorPool.max}}" min="0" step="1" data-dtype="Number" />
          </div>
        </div>

        <div class="form-group">
          <label>Structure</label>
          <input class="type-numeric" type="number" name="system.battleArmor.structure.max" value="{{system.battleArmor.structure.max}}" min="0" step="1" data-dtype="Number" />
        </div>

      </div>

      <div class="mwd-battle-armor-editor__group">
        <div class="mwd-form-section-label">Systems</div>
        <div class="mwd-battle-armor-editor__toggles">
          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Jump Jets"}}
            <input type="checkbox" name="system.battleArmor.systems.jump" {{checked system.battleArmor.systems.jump}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Enhanced Strength"}}
            <input type="checkbox" name="system.battleArmor.systems.enhancedStrength" {{checked system.battleArmor.systems.enhancedStrength}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Sealed"}}
            <input type="checkbox" name="system.battleArmor.systems.sealed" {{checked system.battleArmor.systems.sealed}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Basic Sensors"}}
            <input type="checkbox" name="system.battleArmor.systems.basicSensors" {{checked system.battleArmor.systems.basicSensors}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Pain Suppression"}}
            <input type="checkbox" name="system.battleArmor.systems.medicalSuppression" {{checked system.battleArmor.systems.medicalSuppression}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Attach Harness"}}
            <input type="checkbox" name="system.battleArmor.systems.attachedEligible" {{checked system.battleArmor.systems.attachedEligible}} />
          {{/ "mwd.v2.components.checkbox"}}
        </div>
      </div>

      <div class="mwd-battle-armor-editor__group">
        <div class="mwd-form-section-label">Stealth</div>
        <div class="mwd-battle-armor-editor__split">
          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card mwd-battle-armor-editor__toggle" label="Stealth Armor"}}
            <input type="checkbox" name="system.battleArmor.systems.stealth.enabled" {{checked system.battleArmor.systems.stealth.enabled}} />
          {{/ "mwd.v2.components.checkbox"}}

          <div class="mwd-item-form-grid mwd-armor-profile-grid">
            <div class="form-group">
              <label for="system.battleArmor.machineTargetProfile.stealthTrackingPenalty">Machine Tracking Penalty</label>
              <input class="type-numeric" type="number" name="system.battleArmor.machineTargetProfile.stealthTrackingPenalty" value="{{system.battleArmor.machineTargetProfile.stealthTrackingPenalty}}" min="0" step="1" data-dtype="Number" />
            </div>

            <div class="form-group">
              <label for="system.battleArmor.systems.stealth.detectionStateCap">Acquire Ceiling</label>
              <select name="system.battleArmor.systems.stealth.detectionStateCap" data-dtype="String">
                <option value="" {{#unless system.battleArmor.systems.stealth.detectionStateCap}}selected{{/unless}}>None</option>
                <option value="contact" {{#if (eq system.battleArmor.systems.stealth.detectionStateCap "contact")}}selected{{/if}}>Contact</option>
                <option value="track" {{#if (eq system.battleArmor.systems.stealth.detectionStateCap "track")}}selected{{/if}}>Track</option>
                <option value="lock" {{#if (eq system.battleArmor.systems.stealth.detectionStateCap "lock")}}selected{{/if}}>Lock</option>
              </select>
            </div>
          </div>
        </div>

        <div class="mwd-battle-armor-editor__toggles mwd-battle-armor-editor__toggles--compact">
          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Reveals on Attack"}}
            <input type="checkbox" name="system.battleArmor.systems.stealth.revealedOnAttack" {{checked system.battleArmor.systems.stealth.revealedOnAttack}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Reveals on Jump"}}
            <input type="checkbox" name="system.battleArmor.systems.stealth.revealedOnJump" {{checked system.battleArmor.systems.stealth.revealedOnJump}} />
          {{/ "mwd.v2.components.checkbox"}}

          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label="Reveals on Hit"}}
            <input type="checkbox" name="system.battleArmor.systems.stealth.revealedOnHit" {{checked system.battleArmor.systems.stealth.revealedOnHit}} />
          {{/ "mwd.v2.components.checkbox"}}
        </div>

        <div class="form-group mwd-item-field--wide">
          <label for="system.battleArmor.systems.stealth.counteredBy">Countermeasures</label>
          <input type="text" name="system.battleArmor.systems.stealth.counteredBy" value="{{join system.battleArmor.systems.stealth.counteredBy ', '}}" placeholder="activeProbe, tag, narc, pointblank, revealed" />
        </div>
      </div>

      <div class="mwd-battle-armor-editor__group">
        <div class="mwd-form-section-label">Machine Sensors</div>
        <div class="mwd-battle-armor-editor__split">
          {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card mwd-battle-armor-editor__toggle" label="Targetable"}}
            <input type="checkbox" name="system.battleArmor.machineTargetProfile.machineTargetable" {{checked system.battleArmor.machineTargetProfile.machineTargetable}} />
          {{/ "mwd.v2.components.checkbox"}}

          <div class="mwd-item-form-grid mwd-armor-profile-grid">
            <div class="form-group">
              <label for="system.battleArmor.machineTargetProfile.signature">Signature</label>
              <select name="system.battleArmor.machineTargetProfile.signature" data-dtype="String">
                <option value="low" {{#if (eq system.battleArmor.machineTargetProfile.signature "low")}}selected{{/if}}>Low</option>
                <option value="medium" {{#if (eq system.battleArmor.machineTargetProfile.signature "medium")}}selected{{/if}}>Medium</option>
                <option value="high" {{#if (eq system.battleArmor.machineTargetProfile.signature "high")}}selected{{/if}}>High</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="mwd-battle-armor-editor__group">
        <div class="mwd-form-section-label">Attachment</div>
        <div class="form-group mwd-item-field--wide">
          <label for="system.battleArmor.attachedLocationHint">Location Hint</label>
          <input type="text" name="system.battleArmor.attachedLocationHint" value="{{system.battleArmor.attachedLocationHint}}" />
        </div>
      </div>
    </div>
  {{/if}}
</div>
