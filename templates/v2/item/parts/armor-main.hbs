{{!--
templates/v2/item/parts/armor-main.hbs
Purpose: Legacy compatibility wrapper for the armor details composition.
How it fits: Kept as an aggregate partial while the CSB layout now composes smaller section partials directly.
--}}


<div class="mwd-armor-sheet">
  {{> "mwd.v2.item.parts.armor-summary-hero"}}

  <div class="mwd-armor-main-grid">
    <section class="panel mwd-item-section">
      <header class="mwd-panel__header">
        <h3 class="mwd-panel__title">Combat Essentials</h3>
      </header>
      <div class="mwd-panel__body">
        {{> "mwd.v2.item.parts.armor-combat-essentials"}}
      </div>
    </section>

    <section class="panel mwd-item-section">
      <header class="mwd-panel__header">
        <h3 class="mwd-panel__title">Usage and Protection</h3>
      </header>
      <div class="mwd-panel__body">
        {{> "mwd.v2.item.parts.armor-usage-protection"}}
      </div>
    </section>

    <section class="panel mwd-item-section">
      <header class="mwd-panel__header">
        <h3 class="mwd-panel__title">Traits and Construction</h3>
      </header>
      <div class="mwd-panel__body">
        {{> "mwd.v2.item.parts.armor-identity-fields"}}
        {{> "mwd.v2.item.parts.armor-standard-traits"}}
      </div>
    </section>

    <section class="panel mwd-item-section mwd-item-section--full">
      <header class="mwd-panel__header">
        <h3 class="mwd-panel__title">Notes</h3>
      </header>
      <div class="mwd-panel__body">
        {{> "mwd.v2.item.parts.armor-notes-reference"}}
      </div>
    </section>
  </div>
</div>
