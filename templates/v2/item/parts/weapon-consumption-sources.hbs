{{!--
templates/v2/item/parts/weapon-consumption-sources.hbs
Purpose: Renders consumption source controls for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<section class="mwd-combat-sheet__subsection">
  <header class="mwd-combat-sheet__subheader">
    <h4 class="mwd-combat-sheet__subtitle">Consumption Sources</h4>
    {{#unless (eq system.category "melee")}}
      <button type="button" class="mwd-source-add"><i class="fas fa-plus"></i> Add</button>
    {{/unless}}
  </header>

  {{#if (eq system.category "melee")}}
    <div class="mwd-item-note">Melee weapons do not use payload sources.</div>
  {{else if weaponEditor.consumptionSources.length}}
    <div class="mwd-ammo-profiles">
      {{#each weaponEditor.consumptionSources as |source|}}
        <div class="mwd-ammo-profile define-source" data-source-id="{{source.id}}">
          <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
            <div class="form-group mwd-weapon-compact__field">
              <label>Label</label>
              <input type="text" value="{{source.label}}" class="mwd-source-field" data-source-id="{{source.id}}" data-field="label" />
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label>Kind</label>
              <select class="mwd-source-field" data-source-id="{{source.id}}" data-field="kind">
                {{selectOptions ../weaponEditor.payloadSourceKinds selected=source.kind valueAttr="value" labelAttr="label" localize=false}}
              </select>
            </div>

            {{#if (eq source.kind "internal")}}
              <div class="form-group mwd-weapon-compact__field">
                <label>Current</label>
                <input class="type-numeric mwd-source-field" type="number" value="{{source.tracking.current}}" data-source-id="{{source.id}}" data-field="tracking.current" />
              </div>
              <div class="form-group mwd-weapon-compact__field">
                <label>Reloadable</label>
                <input class="mwd-source-field" type="checkbox" {{checked source.reloadable}} data-source-id="{{source.id}}" data-field="reloadable" />
              </div>
            {{/if}}

            <button type="button" class="mwd-record__icon-btn is-danger mwd-source-delete" data-source-id="{{source.id}}" title="Remove">
              <i class="fas fa-times"></i>
            </button>
          </div>

          {{#unless (eq source.kind "untracked")}}
            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              {{#if (eq source.kind "internal")}}
                <div class="form-group mwd-weapon-compact__field">
                  <label>Max</label>
                  <input class="type-numeric mwd-source-field" type="number" value="{{source.tracking.max}}" data-source-id="{{source.id}}" data-field="tracking.max" />
                </div>
              {{/if}}

              {{#if (eq source.kind "actorResource")}}
                <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                  <label>Actor Path</label>
                  <input type="text" value="{{source.link.actorPath}}" class="mwd-source-field" data-source-id="{{source.id}}" data-field="link.actorPath" />
                </div>
              {{/if}}

              {{#if (eq source.kind "itemRef")}}
                <div class="form-group mwd-weapon-compact__field">
                  <label>Owned Item</label>
                  <select class="mwd-source-field" data-source-id="{{source.id}}" data-field="link.itemId" {{#unless source.ui.hasOwnedActor}}disabled{{/unless}}>
                    <option value="">Select item</option>
                    {{selectOptions source.ui.ownedItemOptions selected=source.link.itemId valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>
              {{/if}}

              {{#if (eq source.kind "itemRef")}}
                <div class="form-group mwd-weapon-compact__field">
                  <label>Track</label>
                  <select class="mwd-source-field" data-source-id="{{source.id}}" data-field="link.itemPath" {{#unless source.ui.hasOwnedActor}}disabled{{/unless}}>
                    {{selectOptions source.ui.itemPathOptions selected=source.link.itemPath valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>
              {{/if}}
            </div>

            {{#if (eq source.kind "itemRef")}}
              {{#if source.ui.showCustomItemPath}}
                <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
                  <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                    <label>Custom Item Path</label>
                    <input type="text" value="{{source.link.itemPath}}" class="mwd-source-field" data-source-id="{{source.id}}" data-field="link.itemPath" />
                  </div>
                </div>
              {{/if}}

              {{#if source.ui.preview}}
                <div class="mwd-item-note">{{source.ui.preview}}</div>
              {{/if}}
            {{/if}}
          {{/unless}}
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="mwd-item-note">No consumption sources defined.</div>
  {{/if}}
</section>
