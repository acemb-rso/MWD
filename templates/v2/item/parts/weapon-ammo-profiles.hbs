{{!--
templates/v2/item/parts/weapon-ammo-profiles.hbs
Purpose: Renders payload and consumption source controls for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<section class="mwd-combat-sheet__subsection">
  <header class="mwd-combat-sheet__subheader">
    <h4 class="mwd-combat-sheet__subtitle">Payloads</h4>
    {{#unless (eq system.category "melee")}}
      <button type="button" class="mwd-payload-add"><i class="fas fa-plus"></i> Add</button>
    {{/unless}}
  </header>

  {{#if (eq system.category "melee")}}
    <div class="mwd-item-note">Melee weapons do not use payloads.</div>
  {{else}}
    <div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
      <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
        <label>Accepted Families</label>
        <input type="text" name="system.payloadCompatibility.families" value="{{weaponEditor.payloadCompatibilityText.families}}" />
        <select class="mwd-list-picker" data-target-name="system.payloadCompatibility.families">
          <option value="">Add family...</option>
          {{selectOptions weaponEditor.payloadFamilyOptions selected="" valueAttr="value" labelAttr="label" localize=false}}
        </select>
      </div>

      <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
        <label>Required Tags</label>
        <input type="text" name="system.payloadCompatibility.tagsAll" value="{{weaponEditor.payloadCompatibilityText.tagsAll}}" />
        <select class="mwd-list-picker" data-target-name="system.payloadCompatibility.tagsAll">
          <option value="">Add tag...</option>
          {{selectOptions weaponEditor.payloadTagOptions selected="" valueAttr="value" labelAttr="label" localize=false}}
        </select>
      </div>
    </div>

    <div class="mwd-ammo-profiles">
      <div class="mwd-ammo-profile">
        <div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
          <div class="form-group mwd-weapon-compact__field">
            <label>Selected Payload</label>
            <div class="mwd-field-cluster__value">{{weaponEditor.activePayloadLabel}}</div>
          </div>

          <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
            <label>Compatible Payload Items</label>
            {{#if weaponEditor.hasActorPayloads}}
              <div class="mwd-item-note">Use the buttons below, drag a payload item here, or click Add to choose from compatible payload items.</div>
            {{else}}
              <div class="mwd-item-note">No compatible actor-owned payload items found.</div>
            {{/if}}
          </div>
        </div>

        {{#if weaponEditor.hasActorPayloads}}
          {{#each weaponEditor.actorPayloads as |payload|}}
            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--actions" data-payload-id="{{payload.id}}">
              <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                <label>{{#if payload.selected}}Selected{{else}}Payload{{/if}}</label>
                <div class="mwd-field-cluster__value">
                  {{payload.label}} | Qty {{payload.quantity}}{{#if payload.stackLabel}} | {{payload.stackLabel}}{{/if}}{{#if payload.tags}} | {{payload.tags}}{{/if}}
                </div>
              </div>

              <button type="button" class="mwd-record__icon-btn mwd-payload-select" data-payload-id="{{payload.id}}" title="Select">
                <i class="fas fa-check"></i>
              </button>
            </div>
          {{/each}}
        {{/if}}
      </div>
    </div>
  {{/if}}

  {{#if (eq system.category "melee")}}
  {{else if system.payloads.length}}
    <div class="mwd-ammo-profiles">
      {{#each system.payloads as |payload|}}
        {{#unless (eq payload.id "unloaded")}}
          <div class="mwd-ammo-profile define-payload" data-payload-id="{{payload.id}}">
            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
              <div class="form-group mwd-weapon-compact__field">
                <label>Label</label>
                <input type="text" value="{{payload.label}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="label" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Damage Type</label>
                <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="modifies.damageType">
                  {{selectOptions ../weaponEditor.ammoDamageTypes selected=payload.modifies.damageType valueAttr="value" labelAttr="label" localize=false}}
                </select>
              </div>

              <button type="button" class="mwd-record__icon-btn is-danger mwd-payload-delete" data-payload-id="{{payload.id}}" title="Remove">
                <i class="fas fa-times"></i>
              </button>
            </div>

            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              <div class="form-group mwd-weapon-compact__field">
                <label>AP Mod</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.ap}}" data-payload-id="{{payload.id}}" data-field="modifies.ap" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label data-tooltip="Roll these dice on a hit or graze. Each success adds +1 damage.">Cluster Dice</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.clusteringDice}}" data-payload-id="{{payload.id}}" data-field="modifies.clusteringDice" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Source</label>
                <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="consumption.sourceId">
                  <option value="">Untracked</option>
                  {{#each ../system.consumptionSources as |source|}}
                    <option value="{{source.id}}" {{#if (eq source.id payload.consumption.sourceId)}}selected{{/if}}>{{source.label}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Use / Attack</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.consumption.amount}}" data-payload-id="{{payload.id}}" data-field="consumption.amount" />
              </div>
            </div>

            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                <label>Compatible With</label>
                <input type="text" value="{{join payload.compatibleWith ', '}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="compatibleWith" />
              </div>
            </div>

            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                <label data-tooltip="Capability traits unlock supported payload behavior. Use the picker to add known capabilities such as templated, smoke, or clustered.">Traits</label>
                <input type="text" value="{{join payload.traits ', '}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="traits" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label data-tooltip="Add a supported payload capability trait to the Traits field.">Add Trait</label>
                <select class="mwd-capability-picker" data-payload-id="{{payload.id}}" data-field="traits" data-values="{{join payload.traits ', '}}">
                  <option value=""></option>
                  {{selectOptions ../weaponEditor.payloadCapabilityOptions selected="" valueAttr="value" labelAttr="label" localize=false}}
                </select>
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Keywords</label>
                <input type="text" value="{{join payload.keywords ', '}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="keywords" />
              </div>
            </div>

            <div class="mwd-weapon-compact__band-grid">
              <div class="form-group mwd-weapon-compact__field">
                <label>AR Close</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.close}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.close" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>AR Near</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.near}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.near" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>AR Far</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.far}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.far" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>AR Extreme</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.extreme}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.extreme" />
              </div>
            </div>

            {{#if (includes payload.traits "templated")}}
              <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
                <div class="form-group mwd-weapon-compact__field">
                  <label>Resolver</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="resolution.resolverKey">
                    {{selectOptions ../weaponEditor.resolverKeys selected=payload.resolution.resolverKey valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>

                <div class="form-group mwd-weapon-compact__field">
                  <label>Template Shape</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="template.shape">
                    <option value=""></option>
                    {{selectOptions ../weaponEditor.payloadTemplateShapes selected=payload.template.shape valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>

                <div class="form-group mwd-weapon-compact__field">
                  <label>Template Size (m)</label>
                  <input class="type-numeric mwd-payload-field" type="number" value="{{payload.template.size}}" data-payload-id="{{payload.id}}" data-field="template.size" />
                </div>

                <div class="form-group mwd-weapon-compact__field">
                  <label>Placement</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="template.placement">
                    <option value=""></option>
                    {{selectOptions ../weaponEditor.payloadTemplatePlacements selected=payload.template.placement valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>
              </div>

              <div class="mwd-weapon-compact__row">
                <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                  <div class="mwd-item-note">Template attacks still require the <strong>templated</strong> trait and valid template config.</div>
                </div>
              </div>

              <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
                <div class="form-group mwd-weapon-compact__field">
                  <label>Area Effect</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="areaEffect.kind">
                    {{selectOptions ../weaponEditor.areaEffectKinds selected=payload.areaEffect.kind valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>
              </div>

              {{#if (eq payload.areaEffect.kind "persistent")}}
                <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
                <div class="form-group mwd-weapon-compact__field">
                  <label>Start Exposure</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="areaEffect.hazard.startExposure">
                    {{selectOptions ../weaponEditor.exposureTiers selected=payload.areaEffect.hazard.startExposure valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>

                <div class="form-group mwd-weapon-compact__field">
                  <label>Escalation Rate</label>
                  <input class="type-numeric mwd-payload-field" type="number" value="{{payload.areaEffect.hazard.escalation.rate}}" data-payload-id="{{payload.id}}" data-field="areaEffect.hazard.escalation.rate" />
                </div>

                <div class="form-group mwd-weapon-compact__field">
                  <label>Interval (Turns)</label>
                  <input class="type-numeric mwd-payload-field" type="number" value="{{payload.areaEffect.hazard.escalation.intervalTurns}}" data-payload-id="{{payload.id}}" data-field="areaEffect.hazard.escalation.intervalTurns" />
                </div>
                </div>

              <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
                <div class="form-group mwd-weapon-compact__field">
                  <label>Escalation Max</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="areaEffect.hazard.escalation.max">
                    {{selectOptions ../weaponEditor.exposureTiers selected=payload.areaEffect.hazard.escalation.max valueAttr="value" labelAttr="label" localize=false}}
                  </select>
                </div>

                <div class="form-group mwd-weapon-compact__field">
                  <label>Full Burn</label>
                  <input class="type-numeric mwd-payload-field" type="number" value="{{payload.areaEffect.hazard.onFull.burnDelta}}" data-payload-id="{{payload.id}}" data-field="areaEffect.hazard.onFull.burnDelta" />
                </div>

                <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                  <label>Clear On Exit</label>
                  <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="areaEffect.hazard.clearOnExit">
                    <option value="true" {{#if payload.areaEffect.hazard.clearOnExit}}selected{{/if}}>Yes</option>
                    <option value="false" {{#unless payload.areaEffect.hazard.clearOnExit}}selected{{/unless}}>No</option>
                  </select>
                </div>
              </div>
              {{else}}
                <div class="mwd-weapon-compact__row">
                  <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                    <div class="mwd-item-note">Discrete template attacks like grenades use the template for targeting only. Exposure and hazard escalation settings apply only to persistent hazards.</div>
                  </div>
                </div>
              {{/if}}
            {{/if}}
          </div>
        {{/unless}}
      {{/each}}
    </div>
  {{/if}}
</section>
