{{!--
templates/v2/item/parts/weapon-ammo-profiles.hbs
Purpose: Renders payload and consumption source controls for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<section class="mwd-combat-sheet__subsection">
  <header class="mwd-combat-sheet__subheader">
    <h4 class="mwd-combat-sheet__subtitle">Payloads</h4>
    {{#unless (eq system.category "melee")}}
      <button type="button" class="mwd-payload-add"><i class="fas fa-plus"></i> Add</button>
    {{/unless}}
  </header>

  {{#if (eq system.category "melee")}}
    <div class="mwd-item-note">Melee weapons do not use payloads.</div>
  {{else if system.payloads.length}}
    <div class="mwd-ammo-profiles">
      {{#each system.payloads as |payload|}}
        <div class="mwd-ammo-profile define-payload" data-payload-id="{{payload.id}}">
          {{#if (eq payload.id "unloaded")}}
            <div class="mwd-weapon-compact__row">
              <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                <label>Built-In State</label>
                <div class="mwd-item-note">Unloaded is the default empty state for ranged weapons. It does not apply modifiers, consume sources, or define munition traits.</div>
              </div>
            </div>
          {{else}}
            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              <div class="form-group mwd-weapon-compact__field">
                <label>Label</label>
                <input type="text" value="{{payload.label}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="label" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Family</label>
                <input type="text" value="{{payload.family}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="family" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Damage Type</label>
                <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="modifies.damageType">
                  {{selectOptions ../weaponEditor.ammoDamageTypes selected=payload.modifies.damageType valueAttr="value" labelAttr="label" localize=false}}
                </select>
              </div>

              <button type="button" class="mwd-record__icon-btn is-danger mwd-payload-delete" data-payload-id="{{payload.id}}" title="Remove">
                <i class="fas fa-times"></i>
              </button>
            </div>

            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
              <div class="form-group mwd-weapon-compact__field">
                <label>AP Mod</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.ap}}" data-payload-id="{{payload.id}}" data-field="modifies.ap" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Source</label>
                <select class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="consumption.sourceId">
                  <option value="">Untracked</option>
                  {{#each ../system.consumptionSources as |source|}}
                    <option value="{{source.id}}" {{#if (eq source.id payload.consumption.sourceId)}}selected{{/if}}>{{source.label}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Use / Attack</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.consumption.amount}}" data-payload-id="{{payload.id}}" data-field="consumption.amount" />
              </div>
            </div>

            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                <label>Compatible With</label>
                <input type="text" value="{{join payload.compatibleWith ', '}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="compatibleWith" />
              </div>
            </div>

            <div class="mwd-weapon-compact__band-grid">
              <div class="form-group mwd-weapon-compact__field">
                <label>AR Close</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.close}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.close" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>AR Near</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.near}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.near" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>AR Far</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.far}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.far" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>AR Extreme</label>
                <input class="type-numeric mwd-payload-field" type="number" value="{{payload.modifies.attackRatingBand.extreme}}" data-payload-id="{{payload.id}}" data-field="modifies.attackRatingBand.extreme" />
              </div>
            </div>

            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
              <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
                <label>Legacy Traits</label>
                <input type="text" value="{{join payload.modifies.traits ', '}}" class="mwd-payload-field" data-payload-id="{{payload.id}}" data-field="modifies.traits" />
              </div>
            </div>

            <div class="mwd-combat-sheet__subsection mwd-combat-sheet__subsection--nested">
              <header class="mwd-combat-sheet__subheader">
                <h4 class="mwd-combat-sheet__subtitle">Payload Standard Traits</h4>
                <button type="button" class="mwd-payload-standard-trait-add" data-payload-id="{{payload.id}}"><i class="fas fa-plus"></i> Add</button>
              </header>

              {{#if payload.modifies.standardTraits.length}}
                {{#each payload.modifies.standardTraits as |trait|}}
                  <div class="mwd-weapon-compact__row mwd-weapon-compact__row--actions" data-payload-id="{{../payload.id}}" data-trait-id="{{trait.id}}">
                    <div class="form-group mwd-weapon-compact__field">
                      <label>Trait</label>
                      <select class="mwd-payload-standard-trait-field" data-payload-id="{{../payload.id}}" data-trait-id="{{trait.id}}" data-field="key">
                        {{selectOptions ../../weaponEditor.standardTraits selected=trait.key valueAttr="value" labelAttr="label" localize=false}}
                      </select>
                    </div>

                    <div class="form-group mwd-weapon-compact__field">
                      <label>Rating</label>
                      <input class="type-numeric mwd-payload-standard-trait-field" type="number" value="{{trait.rating}}" data-payload-id="{{../payload.id}}" data-trait-id="{{trait.id}}" data-field="rating" />
                    </div>

                    <button type="button" class="mwd-record__icon-btn is-danger mwd-payload-standard-trait-delete" data-payload-id="{{../payload.id}}" data-trait-id="{{trait.id}}" title="Remove">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                {{/each}}
              {{else}}
                <div class="mwd-item-note">No standard payload traits defined.</div>
              {{/if}}
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="mwd-item-note">No payloads defined.</div>
  {{/if}}
</section>
