{{!--
templates/v2/item/parts/armor-usage-protection.hbs
Purpose: Renders actor usage state and typed mitigation fields for armor.
How it fits: Used by the CSB-driven armor details layout.
--}}


{{#if itemSheet.canUseActorControls}}
  <div class="mwd-item-toggle-grid">
    {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label=MWD.item.armor.equipped}}
      <input type="checkbox" name="system.equipped" {{checked system.equipped}} />
    {{/ "mwd.v2.components.checkbox"}}

    {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--card" label=MWD.item.armor.primary}}
      <input type="checkbox" name="system.isPrimary" {{checked system.isPrimary}} />
    {{/ "mwd.v2.components.checkbox"}}
  </div>

  {{#if isActiveArmor}}
    <div class="mwd-item-note">
      This armor is currently the actor's active armor. Resistance uses the armor rating, durability is spent with each use, and the effective rating only drops if durability falls below the rating.
    </div>
  {{/if}}
{{else}}
  <div class="mwd-item-note">
    This is a standalone item. Equip and primary controls appear after the armor is embedded in an actor.
  </div>
{{/if}}
