{{!--
templates/v2/item/parts/weapon-standard-traits.hbs
Purpose: Renders curated standard trait controls for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--full mwd-weapon-traits-compact">
  <div class="mwd-weapon-traits-compact__header">
    <label>Standard Traits</label>
    <button type="button" class="mwd-record__icon-btn mwd-weapon-standard-trait-add" title="Add Trait">
      <i class="fas fa-plus"></i>
    </button>
  </div>

  {{#if system.standardTraits.length}}
    <div class="mwd-weapon-traits-compact__list">
      {{#each system.standardTraits as |trait|}}
        <div class="mwd-weapon-traits-compact__row" data-trait-id="{{trait.id}}">
          <select class="mwd-weapon-standard-trait-field" data-trait-id="{{trait.id}}" data-field="key">
            {{selectOptions ../weaponEditor.standardTraits selected=trait.key valueAttr="value" labelAttr="label" localize=false}}
          </select>

          <button type="button" class="mwd-record__icon-btn is-danger mwd-weapon-standard-trait-delete" data-trait-id="{{trait.id}}" title="Remove">
            <i class="fas fa-times"></i>
          </button>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="mwd-weapon-traits-compact__empty">None</div>
  {{/if}}
</div>
