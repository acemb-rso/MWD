{{!--
templates/v2/item/parts/weapon-compact-main.hbs
Purpose: Legacy compatibility wrapper for the personal weapon details composition.
How it fits: Kept as an aggregate partial while the CSB layout now composes smaller section partials directly.
--}}


<div class="mwd-weapon-compact">
  {{#if (eq itemSheet.weaponSheetVariant "mech")}}
    <div class="mwd-item-main-grid">
      <section class="panel mwd-item-section">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Weapon Profile</h3>
        </header>
        <div class="mwd-panel__body">
          <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
            <div class="form-group mwd-weapon-compact__field">
              <label for="system.weaponCategory">{{MWD.item.mechWeapon.category}}</label>
              <select name="system.weaponCategory" data-dtype="String" data-action="weaponCategoryChange">
                {{selectOptions weaponEditor.categories selected=system.weaponCategory valueAttr="value" labelAttr="label" localize=false}}
              </select>
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label for="system.damageType">{{MWD.item.mechWeapon.damageType}}</label>
              <select name="system.damageType" data-dtype="String">
                {{selectOptions weaponEditor.damageTypes selected=system.damageType valueAttr="value" labelAttr="label" localize=false}}
              </select>
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label for="system.size">Size</label>
              <select name="system.size" data-dtype="String">
                {{selectOptions weaponEditor.hardpointSizes selected=system.size valueAttr="value" labelAttr="label" localize=false}}
              </select>
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label for="system.range.max">{{MWD.item.mechWeapon.range.max}}</label>
              <select name="system.range.max" data-dtype="String" {{#if itemSheet.mechIsMelee}}disabled{{/if}}>
                {{selectOptions weaponEditor.ranges selected=system.range.max valueAttr="value" labelAttr="label" localize=false}}
              </select>
            </div>
          </div>

          <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
            <div class="form-group mwd-weapon-compact__field">
              <label for="system.damage">{{MWD.item.mechWeapon.damage}}</label>
              <input class="type-numeric" type="number" name="system.damage" value="{{system.damage}}" data-dtype="Number" />
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label>Attack Skill</label>
              <div class="mwd-field-cluster__value">{{itemSheet.mechDerivedSkillLabel}}</div>
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label for="system.heat">{{MWD.item.mechWeapon.heat}}</label>
              <input class="type-numeric" type="number" name="system.heat" value="{{system.heat}}" data-dtype="Number" />
            </div>

            <div class="form-group mwd-weapon-compact__field">
              <label for="system.area">{{MWD.item.mechWeapon.area}}</label>
              <select name="system.area" data-dtype="String">
                {{selectOptions ENUMS.areas selected=system.area valueAttr="value" labelAttr="label" localize=false blank=""}}
              </select>
            </div>
          </div>

          <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
            {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--inline" label="Volatile"}}
              <input class="item-field-value" name="system.volatile" type="checkbox" {{checked system.volatile}} />
            {{/ "mwd.v2.components.checkbox"}}
          </div>

          {{#unless itemSheet.mechIsMelee}}
            <div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
              <div class="form-group mwd-weapon-compact__field">
                <label for="system.selectedPayloadId">Selected Payload</label>
                <select name="system.selectedPayloadId" data-dtype="String">
                  {{#each system.payloads as |payload|}}
                    <option value="{{payload.id}}" {{#if (eq payload.id ../system.selectedPayloadId)}}selected{{/if}}>{{payload.label}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Active Payload</label>
                <div class="mwd-field-cluster__value">{{weaponProfile.payloadLabel}}</div>
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Source</label>
                <div class="mwd-field-cluster__value">{{#if weaponProfile.sourceState.label}}{{weaponProfile.sourceState.label}}{{else}}Untracked{{/if}}</div>
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label>Available</label>
                <div class="mwd-field-cluster__value">
                  {{#if weaponProfile.sourceState.isTracked}}
                    {{weaponProfile.sourceState.current}} / {{weaponProfile.sourceState.max}}
                  {{else}}
                    Untracked
                  {{/if}}
                </div>
              </div>
            </div>
          {{/unless}}
        </div>
      </section>

      <section class="panel mwd-item-section">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Range Bands</h3>
        </header>
        <div class="mwd-panel__body">
          {{#if itemSheet.mechIsMelee}}
            <div class="mwd-item-note">Melee mech weapons stay in close range and do not use ranged bands.</div>
          {{else}}
            <div class="mwd-weapon-compact__band-grid">
              <div class="form-group mwd-weapon-compact__field">
                <label for="system.range.close">{{weaponEditor.rangeBandLabels.close}}</label>
                <input class="type-numeric" type="number" name="system.range.close" value="{{system.range.close}}" data-dtype="Number" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label for="system.range.near">{{weaponEditor.rangeBandLabels.near}}</label>
                <input class="type-numeric" type="number" name="system.range.near" value="{{system.range.near}}" data-dtype="Number" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label for="system.range.far">{{weaponEditor.rangeBandLabels.far}}</label>
                <input class="type-numeric" type="number" name="system.range.far" value="{{system.range.far}}" data-dtype="Number" />
              </div>

              <div class="form-group mwd-weapon-compact__field">
                <label for="system.range.extreme">{{weaponEditor.rangeBandLabels.extreme}}</label>
                <input class="type-numeric" type="number" name="system.range.extreme" value="{{system.range.extreme}}" data-dtype="Number" />
              </div>
            </div>
          {{/if}}
        </div>
      </section>

      <section class="panel mwd-item-section mwd-item-section--full">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Payloads</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-ammo-profiles"}}
        </div>
      </section>

      <section class="panel mwd-item-section mwd-item-section--full">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Consumption Sources</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-consumption-sources"}}
        </div>
      </section>

      <section class="panel mwd-item-section mwd-item-section--full">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Notes and Reference</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-notes-reference"}}
        </div>
      </section>
    </div>
  {{else}}
    {{> "mwd.v2.item.parts.weapon-summary-hero"}}

    <div class="mwd-item-main-grid">
      <section class="panel mwd-item-section">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Combat Essentials</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-combat-essentials"}}
        </div>
      </section>

      <section class="panel mwd-item-section mwd-item-section--usage-bands">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Usage and Bands</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-usage-bands"}}
        </div>
      </section>

      <section class="panel mwd-item-section mwd-item-section--full">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Payloads and Ammunition</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-ammo-profiles"}}
        </div>
      </section>

      <section class="panel mwd-item-section mwd-item-section--full">
        <header class="mwd-panel__header">
          <h3 class="mwd-panel__title">Notes and Reference</h3>
        </header>
        <div class="mwd-panel__body">
          {{> "mwd.v2.item.parts.weapon-notes-reference"}}
        </div>
      </section>
    </div>
  {{/if}}
</div>
