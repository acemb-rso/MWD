{{!--
templates/v2/item/parts/weapon-combat-essentials.hbs
Purpose: Renders the core editable combat profile fields for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.skill">{{MWD.item.personalWeapon.skill}}</label>
    <select class="select-weapon-skill" name="system.skill" data-dtype="String" data-action="weaponSkillChange">
      {{selectOptions weaponEditor.skills selected=system.skill valueAttr="value" labelAttr="label" localize=false blank=""}}
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.category">{{MWD.item.personalWeapon.category}}</label>
    <select name="system.category" data-dtype="String">
      {{selectOptions weaponEditor.categories selected=system.category valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.damageType">{{MWD.item.personalWeapon.damageType}}</label>
    <select name="system.damageType" data-dtype="String">
      {{selectOptions weaponEditor.damageTypes selected=system.damageType valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.range.max">{{MWD.item.personalWeapon.range.max}}</label>
    <select name="system.range.max" data-dtype="String">
      {{selectOptions weaponEditor.ranges selected=weaponProfile.range.max valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>
</div>

<div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.damage">{{MWD.item.personalWeapon.damageShort}}</label>
    <input class="type-numeric" type="number" name="system.damage" value="{{system.damage}}" data-dtype="Number" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.ap">{{MWD.item.personalWeapon.apShort}}</label>
    <input class="type-numeric" type="number" name="system.ap" value="{{system.ap}}" data-dtype="Number" />
  </div>

  {{#unless (eq system.category "melee")}}
    <div class="form-group mwd-weapon-compact__field">
      <label for="system.selectedPayloadId">Selected Payload</label>
      <select name="system.selectedPayloadId" data-dtype="String">
        {{#each system.payloads as |payload|}}
          <option value="{{payload.id}}" {{#if (eq payload.id ../system.selectedPayloadId)}}selected{{/if}}>{{payload.label}}</option>
        {{/each}}
      </select>
    </div>
  {{/unless}}
</div>

<div class="mwd-weapon-compact__row">
  <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
    <label for="system.traits">Traits</label>
    <input type="text" name="system.traits" value="{{join system.traits ', '}}" data-dtype="String" />
  </div>
</div>

<div class="mwd-weapon-compact__row mwd-weapon-compact__row--2">
  <div class="form-group mwd-weapon-compact__field mwd-weapon-compact__field--wide">
    <label for="system.keywords">Keywords</label>
    <input type="text" name="system.keywords" value="{{join system.keywords ', '}}" data-dtype="String" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.resolution.resolverKey">Resolver</label>
    <select name="system.resolution.resolverKey" data-dtype="String">
      {{selectOptions weaponEditor.resolverKeys selected=system.resolution.resolverKey valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>
</div>

<div class="mwd-weapon-compact__band-grid">
  <div class="form-group mwd-weapon-compact__field">
    <label>
      <input type="checkbox" name="system.fireModes.single.enabled" {{checked system.fireModes.single.enabled}} data-dtype="Boolean" />
      Single
    </label>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label>
      <input type="checkbox" name="system.fireModes.burst.enabled" {{checked system.fireModes.burst.enabled}} data-dtype="Boolean" />
      Burst
    </label>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label>
      <input type="checkbox" name="system.fireModes.fullAuto.enabled" {{checked system.fireModes.fullAuto.enabled}} data-dtype="Boolean" />
      Full Auto
    </label>
  </div>
</div>

<div class="mwd-weapon-compact__band-grid">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.fireModes.burst.shots">Burst Shots</label>
    <input class="type-numeric" type="number" name="system.fireModes.burst.shots" value="{{system.fireModes.burst.shots}}" data-dtype="Number" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.fireModes.burst.accuracyMod">Burst Acc.</label>
    <input class="type-numeric" type="number" name="system.fireModes.burst.accuracyMod" value="{{system.fireModes.burst.accuracyMod}}" data-dtype="Number" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.fireModes.burst.addHeat">Burst Heat</label>
    <input class="type-numeric" type="number" name="system.fireModes.burst.addHeat" value="{{system.fireModes.burst.addHeat}}" data-dtype="Number" />
  </div>
</div>

<div class="mwd-weapon-compact__band-grid">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.fireModes.fullAuto.shots">Auto Shots</label>
    <input class="type-numeric" type="number" name="system.fireModes.fullAuto.shots" value="{{system.fireModes.fullAuto.shots}}" data-dtype="Number" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.fireModes.fullAuto.accuracyMod">Auto Acc.</label>
    <input class="type-numeric" type="number" name="system.fireModes.fullAuto.accuracyMod" value="{{system.fireModes.fullAuto.accuracyMod}}" data-dtype="Number" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.fireModes.fullAuto.addHeat">Auto Heat</label>
    <input class="type-numeric" type="number" name="system.fireModes.fullAuto.addHeat" value="{{system.fireModes.fullAuto.addHeat}}" data-dtype="Number" />
  </div>
</div>
