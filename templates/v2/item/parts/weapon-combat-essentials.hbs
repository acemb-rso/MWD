{{!--
templates/v2/item/parts/weapon-combat-essentials.hbs
Purpose: Renders the core editable combat profile fields for personal weapons.
How it fits: Used by the CSB-driven personal weapon details layout.
--}}


<div class="mwd-weapon-compact__row mwd-weapon-compact__row--4">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.skill">{{MWD.item.personalWeapon.skill}}</label>
    <select class="select-weapon-skill" name="system.skill" data-dtype="String" data-action="weaponSkillChange">
      {{selectOptions weaponEditor.skills selected=system.skill valueAttr="value" labelAttr="label" localize=false blank=""}}
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.category">{{MWD.item.personalWeapon.category}}</label>
    <select name="system.category" data-dtype="String">
      {{selectOptions weaponEditor.categories selected=system.category valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.damageType">{{MWD.item.personalWeapon.damageType}}</label>
    <select name="system.damageType" data-dtype="String">
      {{selectOptions weaponEditor.damageTypes selected=system.damageType valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.range.max">{{MWD.item.personalWeapon.range.max}}</label>
    <select name="system.range.max" data-dtype="String">
      {{selectOptions weaponEditor.ranges selected=system.range.max valueAttr="value" labelAttr="label" localize=false}}
    </select>
  </div>
</div>

<div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.damage">{{MWD.item.personalWeapon.damageShort}}</label>
    <input class="type-numeric" type="number" name="system.damage" value="{{system.damage}}" data-dtype="Number" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.ap">{{MWD.item.personalWeapon.apShort}}</label>
    <input class="type-numeric" type="number" name="system.ap" value="{{system.ap}}" data-dtype="Number" />
  </div>

  {{#unless (eq system.category "melee")}}
    <div class="form-group mwd-weapon-compact__field">
      <label>Selected Payload</label>
      <select class="mwd-active-payload-select" data-action="setActivePayload">
        {{#each weaponEditor.payloadOptions as |payload|}}
          <option value="{{payload.value}}" {{#if payload.selected}}selected{{/if}}>{{payload.label}}</option>
        {{/each}}
      </select>
    </div>
  {{/unless}}
</div>

<div class="mwd-weapon-compact__row mwd-weapon-compact__row--3">
  <div class="form-group mwd-weapon-compact__field">
    <label for="system.scale">Damage Scale</label>
    <select name="system.scale" data-dtype="String">
      <option value="personal" {{#if (eq system.scale "personal")}}selected{{/if}}>Personal</option>
      <option value="machine" {{#if (eq system.scale "machine")}}selected{{/if}}>Machine</option>
    </select>
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.mount.mountedOnItemId">Battle Armor Mount</label>
    <input type="text" name="system.mount.mountedOnItemId" value="{{system.mount.mountedOnItemId}}" placeholder="Armor item id" />
  </div>

  <div class="form-group mwd-weapon-compact__field">
    <label for="system.mount.mountType">Mount Type</label>
    <input type="text" name="system.mount.mountType" value="{{system.mount.mountType}}" placeholder="weapon, tag, narc" />
  </div>
</div>
