{{!--
templates/v2/item/parts/armor-resistance-modifiers.hbs
Purpose: Renders editable defense and typed resistance modifier fields for armor.
How it fits: Included by the layout-backed armor accordion section.
--}}


<div class="mwd-item-form-grid mwd-armor-mitigation-grid">
  <div class="form-group">
    <label for="system.defenseBonus">{{MWD.item.armor.defenseBonus}}</label>
    <input class="type-numeric" type="number" name="system.defenseBonus" value="{{system.defenseBonus}}" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mitigationByType.penetrating">Penetrating</label>
    <input class="type-numeric" type="number" name="system.mitigationByType.penetrating" value="{{system.mitigationByType.penetrating}}" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mitigationByType.concussive">Concussive</label>
    <input class="type-numeric" type="number" name="system.mitigationByType.concussive" value="{{system.mitigationByType.concussive}}" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mitigationByType.energy">Energy</label>
    <input class="type-numeric" type="number" name="system.mitigationByType.energy" value="{{system.mitigationByType.energy}}" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mitigationByType.thermal">Thermal</label>
    <input class="type-numeric" type="number" name="system.mitigationByType.thermal" value="{{system.mitigationByType.thermal}}" data-dtype="Number" />
  </div>

  <div class="form-group">
    <label for="system.mitigationByType.electrical">Electrical</label>
    <input class="type-numeric" type="number" name="system.mitigationByType.electrical" value="{{system.mitigationByType.electrical}}" data-dtype="Number" />
  </div>
</div>
