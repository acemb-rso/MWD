{{!--
templates/v2/item/parts/references.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="form-group">
  <label for="sourceReference">{{MWD.common.sourceReference}} </label>
  <input class="item-field-value" type="text" data-dtype="String"
      name="system.sourceReference" value="{{system.sourceReference}}" 
      placeholder="{{MWD.common.sourceReferenceHelp}}"
  />
</div>
<div class="section-group form-group">
  <div class="flexcol">
    <span><label>{{MWD.common.description}}</label></span>
    <div class="editor">
      {{formInput fields.description
        name="system.description"
        value=system.description
        enriched=enriched.system.description
        toggled=true}}
    </div>
  </div>
</div>

