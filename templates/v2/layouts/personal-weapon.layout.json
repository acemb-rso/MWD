{
  "id": "personal-weapon",
  "version": 1,
  "root": {
    "type": "stack",
    "classes": ["csb-layout", "mwd-item-layout"],
    "children": [
      {
        "type": "tabs",
        "group": "primary",
        "default": "main",
        "classes": ["csb-body", "mwd-body"],
        "tabs": [
          {
            "id": "main",
            "label": "Details",
            "children": [
              { "type": "include", "partial": "mwd.v2.item.parts.weapon-summary-hero" },
              {
                "type": "stack",
                "classes": ["mwd-item-main-grid"],
                "children": [
                  {
                    "type": "panel",
                    "title": "Combat Essentials",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.item.parts.weapon-combat-essentials" }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Usage and Bands",
                    "classes": ["mwd-item-section--usage-bands"],
                    "children": [
                      { "type": "include", "partial": "mwd.v2.item.parts.weapon-usage-bands" }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Traits, Payloads, and Sources",
                    "classes": ["mwd-item-section--full"],
                    "children": [
                      {
                        "type": "tabs",
                        "group": "weapon-load-config",
                        "default": "traits",
                        "classes": ["mwd-combat-sheet__detail-tabs"],
                        "tabs": [
                          {
                            "id": "traits",
                            "label": "Traits",
                            "children": [
                              { "type": "include", "partial": "mwd.v2.item.parts.weapon-standard-traits" }
                            ]
                          },
                          {
                            "id": "payloads",
                            "label": "Payloads",
                            "children": [
                              { "type": "include", "partial": "mwd.v2.item.parts.weapon-ammo-profiles" }
                            ]
                          },
                          {
                            "id": "sources",
                            "label": "Sources",
                            "children": [
                              { "type": "include", "partial": "mwd.v2.item.parts.weapon-consumption-sources" }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Notes and Reference",
                    "classes": ["mwd-item-section--full"],
                    "children": [
                      { "type": "include", "partial": "mwd.v2.item.parts.weapon-notes-reference" }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "modifiers",
            "label": "Roll Modifiers",
            "children": [
              { "type": "include", "partial": "mwd.v2.item.parts.modifiers" }
            ]
          },
          {
            "id": "effects",
            "label": "Active Effects",
            "children": [
              { "type": "include", "partial": "mwd.v2.item.parts.item-effects" }
            ]
          }
        ]
      }
    ]
  }
}
