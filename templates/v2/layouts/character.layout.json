{
  "id": "character",
  "version": 1,
  "root": {
    "type": "stack",
    "classes": ["csb-layout", "character-layout"],
    "children": [
      {
        "type": "stack",
        "classes": ["csb-topband", "mwd-topband", "mwd-topband--character"],
        "children": [
          {
            "type": "stack",
            "classes": ["csb-topband__attributes", "mwd-attributes-panel", "mwd-attributes-panel--hex"],
            "children": [
              {
                "type": "include",
                "partial": "mwd.v2.ui.character.attributes",
                "classes": ["mwd-attributes"]
              }
            ]
          },
          {
            "type": "panel",
            "title": "Edge",
            "classes": ["csb-topband__edge"],
            "children": [
              {
                "type": "include",
                "partial": "mwd.v2.ui.placeholders.edge-console",
                "classes": ["edge-console"]
              }
            ]
          },
          {
            "type": "panel",
            "title": "Condition Monitors",
            "classes": ["csb-topband__monitors"],
            "children": [
              {
                "type": "include",
                "partial": "mwd.v2.ui.placeholders.condition-monitors"
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "classes": ["csb-body", "mwd-body"],
        "children": [
          {
            "type": "tabs",
            "group": "primary",
            "default": "combat",
            "renderMode": "stack",
            "tabs": [
              {
                "id": "combat",
                "label": "Combat Readiness",
                "children": [
                  {
                    "type": "panel",
                    "title": "Combat Actions",
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.character.combat-actions"
                      }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Status Dashboard",
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.placeholders.status-dashboard"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "skills",
                "label": "Skills",
                "children": [
                  {
                    "type": "stack",
                    "classes": ["mwd-skills-grid"],
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.character.skills-column",
                        "context": { "skills": "left" }
                      },
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.character.skills-column",
                        "context": { "skills": "right" }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "inventory",
                "label": "Inventory",
                "children": [
                  {
                    "type": "panel",
                    "title": "Gear",
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.placeholders.inventory-gear"
                      }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Weapons",
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.placeholders.inventory-weapons"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "assigned",
                "label": "Assigned Systems",
                "children": [
                  {
                    "type": "panel",
                    "title": "Assigned Systems",
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.placeholders.assigned-systems"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "bio",
                "label": "Bio",
                "children": [
                  {
                    "type": "panel",
                    "title": "Description",
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.placeholders.bio-description"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
