{
  "id": "character",
  "version": 1,
  "root": {
    "type": "stack",
    "classes": ["csb-layout", "character-layout"],
    "children": [
      {
        "type": "stack",
        "classes": ["mwd-fixed-top"],
        "children": [
          {
            "type": "stack",
            "classes": ["csb-topband__attributes", "mwd-attributes-panel", "mwd-attributes-panel--hex"],
            "children": [
              {
                "type": "include",
                "partial": "mwd.v2.ui.character.attributes",
                "classes": ["mwd-attributes"]
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "classes": ["mwd-scroll-area"],
        "children": [
          {
            "type": "panel",
            "title": "Edge",
            "classes": ["csb-topband__edge"],
            "children": [
              {
                "type": "include",
                "partial": "mwd.v2.ui.character.edge-console",
                "classes": ["edge-console"]
              }
            ]
          },
          {
            "type": "panel",
            "title": "Condition Monitors",
            "classes": ["csb-topband__monitors"],
            "children": [
              {
                "type": "stack",
                "classes": ["mwd-monitors-row"],
                "children": [
                  {
                    "type": "include",
                    "partial": "mwd.v2.ui.condition-monitors"
                  },
                  {
                    "type": "include",
                    "partial": "mwd.v2.ui.character.burn-monitor"
                  }
                ]
              }
            ]
          },
          {
            "type": "tabs",
            "group": "primary",
            "default": "combat",
            "renderMode": "stack",
            "classes": ["csb-body", "mwd-body"],
            "tabs": [
              {
                "id": "combat",
                "label": "Combat Readiness",
                "children": [
                  {
                    "type": "panel",
                    "title": "Combat Actions",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.character.combat-actions" }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Status Dashboard",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.character.status-dashboard" }
                    ]
                  }
                ]
              },
              {
                "id": "skills",
                "label": "Skills",
                "children": [
                  {
                    "type": "stack",
                    "classes": ["mwd-skills-grid"],
                    "children": [
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.character.skills-column",
                        "context": { "skills": "left" }
                      },
                      {
                        "type": "include",
                        "partial": "mwd.v2.ui.character.skills-column",
                        "context": { "skills": "right" }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "inventory",
                "label": "Inventory",
                "children": [
                  {
                    "type": "panel",
                    "title": "Gear",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.placeholders.inventory-gear" }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Weapons",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.placeholders.inventory-weapons" }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Armor",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.placeholders.inventory-armor" }
                    ]
                  }
                ]
              },
              {
                "id": "assigned",
                "label": "Assigned Systems",
                "children": [
                  {
                    "type": "panel",
                    "title": "Assigned Systems",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.placeholders.assigned-systems" }
                    ]
                  }
                ]
              },
              {
                "id": "bio",
                "label": "Bio",
                "children": [
                  {
                    "type": "panel",
                    "title": "Description",
                    "children": [
                      { "type": "include", "partial": "mwd.v2.ui.placeholders.bio-description" }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
