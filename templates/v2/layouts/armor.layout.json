{
  "id": "armor",
  "version": 2,
  "root": {
    "type": "stack",
    "classes": ["csb-layout", "mwd-item-layout"],
    "children": [
      {
        "type": "tabs",
        "group": "primary",
        "default": "main",
        "classes": ["csb-body", "mwd-body"],
        "tabs": [
          {
            "id": "main",
            "label": "Details",
            "children": [
              { "type": "include", "partial": "mwd.v2.item.parts.armor-summary-hero" },
              {
                "type": "stack",
                "classes": ["mwd-armor-main-grid"],
                "children": [
                  {
                    "type": "accordion",
                    "group": "armor-essentials",
                    "default": "",
                    "sections": [
                      {
                        "id": "essentials",
                        "label": "Essentials",
                        "children": [
                          { "type": "include", "partial": "mwd.v2.item.parts.armor-combat-essentials" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Usage and Protection",
                    "classes": ["mwd-item-section"],
                    "children": [
                      { "type": "include", "partial": "mwd.v2.item.parts.armor-usage-protection" },
                      {
                        "type": "accordion",
                        "group": "armor-resistance-modifiers",
                        "default": "",
                        "sections": [
                          {
                            "id": "modifiers",
                            "label": "Protection Modifiers",
                            "summaryPath": "armorModifierSummary",
                            "children": [
                              { "type": "include", "partial": "mwd.v2.item.parts.armor-resistance-modifiers" }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Traits and Construction",
                    "classes": ["mwd-item-section"],
                    "children": [
                      { "type": "include", "partial": "mwd.v2.item.parts.armor-identity-fields" },
                      { "type": "include", "partial": "mwd.v2.item.parts.armor-standard-traits" }
                    ]
                  },
                  {
                    "type": "panel",
                    "title": "Notes",
                    "classes": ["mwd-item-section", "mwd-item-section--full"],
                    "children": [
                      { "type": "include", "partial": "mwd.v2.item.parts.armor-notes-reference" }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "modifiers",
            "label": "Modifiers",
            "children": [
              { "type": "include", "partial": "mwd.v2.item.parts.modifiers" }
            ]
          },
          {
            "id": "effects",
            "label": "Effects",
            "children": [
              { "type": "include", "partial": "mwd.v2.item.parts.item-effects" }
            ]
          }
        ]
      }
    ]
  }
}
