{
  "id": "vehicle",
  "version": 1,
  "root": {
    "type": "stack",
    "classes": ["csb-layout", "vehicle-layout", "mwd-vehicle-layout"],
    "children": [
      {
        "type": "panel",
        "title": "Overview",
        "children": [
          { "type": "include", "partial": "mwd.v2.ui.vehicle.summary-bar" }
        ]
      },
      {
        "type": "tabs",
        "group": "primary",
        "default": "systems",
        "classes": ["csb-body", "mwd-body"],
        "tabs": [
          {
            "id": "systems",
            "label": "Systems",
            "children": [
              {
                "type": "panel",
                "title": "Movement Profile",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.movement-profile" }
                ]
              },
              {
                "type": "panel",
                "title": "Attributes",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.attributes-grid" }
                ]
              },
              {
                "type": "panel",
                "title": "Signature",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.signature-panel" }
                ]
              },
              {
                "type": "panel",
                "title": "Movement",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.movement-grid" }
                ]
              },
              {
                "type": "panel",
                "title": "Structure",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.condition-monitors" }
                ]
              },
              {
                "type": "panel",
                "title": "Strain",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.strain-track" }
                ]
              },
              {
                "type": "panel",
                "title": "Criticals",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.active-crits" }
                ]
              },
              {
                "type": "panel",
                "title": "Degradation",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.degradation-grid" }
                ]
              },
              {
                "type": "panel",
                "title": "Pilot / Driver",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.pilot-panel" }
                ]
              },
              {
                "type": "panel",
                "title": "Crew",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.crew-panel" }
                ]
              }
            ]
          },
          {
            "id": "weapons",
            "label": "Combat",
            "children": [
              {
                "type": "panel",
                "title": "Quick Actions",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.vehicle.quick-actions" }
                ]
              },
              {
                "type": "panel",
                "title": "Combat Awareness",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.combat-awareness-preview" }
                ]
              },
              {
                "type": "panel",
                "title": "Hardpoints",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.hardpoint-list" }
                ]
              },
              {
                "type": "panel",
                "title": "Hardpoint Slots",
                "children": [
                  {
                    "type": "include",
                    "partial": "mwd.v2.ui.vehicle.record-section",
                    "context": { "sectionId": "slots" }
                  }
                ]
              }
            ]
          },
          {
            "id": "support",
            "label": "Support",
            "children": [
              {
                "type": "panel",
                "title": "Upgrades",
                "children": [
                  {
                    "type": "include",
                    "partial": "mwd.v2.ui.vehicle.record-section",
                    "context": { "sectionId": "upgrades" }
                  }
                ]
              },
              {
                "type": "panel",
                "title": "Modules",
                "children": [
                  {
                    "type": "include",
                    "partial": "mwd.v2.ui.vehicle.record-section",
                    "context": { "sectionId": "modules" }
                  }
                ]
              },
              {
                "type": "panel",
                "title": "Gear",
                "children": [
                  {
                    "type": "include",
                    "partial": "mwd.v2.ui.vehicle.record-section",
                    "context": { "sectionId": "gear" }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
