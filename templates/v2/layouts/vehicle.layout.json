{
  "id": "vehicle",
  "version": 1,
  "root": {
    "type": "stack",
    "classes": ["csb-layout"],
    "children": [
      {
        "type": "tabs",
        "group": "primary",
        "default": "overview",
        "classes": ["csb-body", "mwd-body"],
        "tabs": [
          {
            "id": "overview",
            "label": "Vehicle",
            "children": [
              {
                "type": "panel",
                "title": "Profile",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.field-grid", "context": { "columns": 2, "fieldsKey": "profileFields" } }
                ]
              },
              {
                "type": "panel",
                "title": "Attributes",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.field-grid", "context": { "columns": 4, "fieldsKey": "attributeFields" } }
                ]
              },
              {
                "type": "panel",
                "title": "Durability and Systems",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.field-grid", "context": { "columns": 3, "fieldsKey": "monitorFields" } }
                ]
              },
              {
                "type": "panel",
                "title": "Quick Actions",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.action-buttons", "context": { "actionsKey": "quickActions" } }
                ]
              }
            ]
          },
          {
            "id": "crew",
            "label": "Crew",
            "children": [
              {
                "type": "panel",
                "title": "Crew State",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.field-grid", "context": { "columns": 4, "fieldsKey": "crewFields" } }
                ]
              },
              {
                "type": "panel",
                "title": "Driver Snapshot",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.field-grid", "context": { "columns": 3, "fieldsKey": "snapshotFields" } }
                ]
              }
            ]
          },
          {
            "id": "loadout",
            "label": "Loadout",
            "children": [
              {
                "type": "panel",
                "title": "Skills",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.owned-item-list", "context": { "collectionKey": "skills", "itemType": "skill", "addLabel": "Skill", "emptyLabel": "No skills assigned." } }
                ]
              },
              {
                "type": "panel",
                "title": "Weapons",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.owned-item-list", "context": { "collectionKey": "weapons", "itemType": "mechWeapon", "addLabel": "Weapon", "emptyLabel": "No weapons assigned." } }
                ]
              },
              {
                "type": "panel",
                "title": "Cargo and Modules",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.owned-item-list", "context": { "collectionKey": "gear", "itemType": "gear", "addLabel": "Gear", "emptyLabel": "No cargo assigned." } }
                ]
              }
            ]
          },
          {
            "id": "notes",
            "label": "Notes",
            "children": [
              {
                "type": "panel",
                "title": "Description",
                "children": [
                  { "type": "include", "partial": "mwd.v2.ui.actor.notes-editor" }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
