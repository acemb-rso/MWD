{{!--
templates/v2/roll/mwd-roll-dialog.hbs
Purpose: Renders collections with `each` blocks. Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<section class="mwd-roll-dialog__root">

  <header class="mwd-roll-dialog__header">
    <div class="mwd-roll-dialog__title">
      <div class="mwd-roll-dialog__title-left">{{header.left}}</div>
      <div class="mwd-roll-dialog__title-right">{{header.right}}</div>
    </div>
    {{#if formula}}
      <div class="mwd-roll-dialog__title-formula">{{formula}}</div>
    {{/if}}
  </header>

  <div class="mwd-roll-dialog__panel">
    <div class="mwd-roll-dialog__panel-title">Dice Breakdown</div>

<div class="mwd-roll-dialog__grid">
  {{#if (eq intent "edge")}}

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Edge Pool</div>
      <div class="mwd-roll-dialog__pill">{{dice.pool}}</div>
    </div>

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Rating</div>
      <div class="mwd-roll-dialog__pill">{{dice.rating}}</div>
    </div>

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Edge Cap</div>
      <div class="mwd-roll-dialog__pill">{{dice.cap}}</div>
    </div>

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Existing Mods</div>
      <div class="mwd-roll-dialog__pill">{{dice.modifiers}}</div>
    </div>

  {{else}}

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Attribute</div>
      <div class="mwd-roll-dialog__pill">{{dice.attribute}}</div>
    </div>

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Skill</div>
      <div class="mwd-roll-dialog__pill">{{dice.skill}}</div>
    </div>

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Bonus</div>
      <div class="mwd-roll-dialog__pill">{{dice.bonus}}</div>
    </div>

    {{#if dice.specialization}}
      <div class="mwd-roll-dialog__row">
        <div class="mwd-roll-dialog__label">Specialization</div>
        <div class="mwd-roll-dialog__pill">{{dice.specialization}}</div>
      </div>
    {{/if}}

    <div class="mwd-roll-dialog__row">
      <div class="mwd-roll-dialog__label">Existing Mods</div>
      <div class="mwd-roll-dialog__pill">{{dice.modifiers}}</div>
    </div>

  {{/if}}
</div>

    <div class="mwd-roll-dialog__total">
      <span class="mwd-roll-dialog__total-label">Total Pool</span>
      <span class="mwd-roll-dialog__pill mwd-roll-dialog__pill--strong">{{totalPool}}</span>
    </div>
  </div>

  {{#if attack}}
    <div class="mwd-roll-dialog__panel">
      <div class="mwd-roll-dialog__panel-title">Attack Load</div>

      <div class="mwd-roll-dialog__grid">
        <div class="mwd-roll-dialog__row">
          <div class="mwd-roll-dialog__label">Weapon</div>
          <div class="mwd-roll-dialog__pill">{{attack.weaponName}}</div>
        </div>

        <div class="mwd-roll-dialog__row">
          <div class="mwd-roll-dialog__label">Range</div>
          <div class="mwd-roll-dialog__pill">{{attack.rangeBand}}</div>
        </div>

        <div class="mwd-roll-dialog__row">
          <div class="mwd-roll-dialog__label">Type</div>
          <div class="mwd-roll-dialog__pill">{{attack.damageType}}</div>
        </div>

        {{#if attack.usesPayloads}}
          <div class="mwd-roll-dialog__row">
            <div class="mwd-roll-dialog__label">Payload</div>
            <div class="mwd-roll-dialog__pill">
              {{#if attack.selectedPayloadLabel}}{{attack.selectedPayloadLabel}}{{else}}Unloaded{{/if}}
              {{#if attack.source.isTracked}} ({{attack.source.current}}/{{attack.source.max}}){{/if}}
            </div>
          </div>
        {{/if}}
      </div>

      {{#if attack.usesPayloads}}
        <div class="mwd-field">
          <label>Selected Payload</label>
          <select data-action="setPayload">
            {{#each attack.payloads as |payload|}}
              <option value="{{payload.id}}" {{#if payload.selected}}selected{{/if}}>{{payload.name}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if specialization}}
    <div class="mwd-field">
      <label>Specialization</label>
      <select data-action="setSpecialization" data-skill-code="{{specialization.skillCode}}">
        <option value="">None</option>
        {{#each specialization.options as |option|}}
          <option value="{{option.key}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
        {{/each}}
      </select>
    </div>
  {{/if}}

  <div class="mwd-field">
    <label>DN (Hits Needed)</label>
    <input
      type="number"
      min="0"
      step="1"
      name="dn"
      value="{{dn}}"
    />
  </div>


  <div class="mwd-roll-dialog__panel">
    <div class="mwd-roll-dialog__panel-title">Modifiers</div>

    {{#if modifiers.length}}
      <ul class="mwd-roll-dialog__mods">
        {{#each modifiers}}
          <li class="mwd-roll-dialog__mod">
            <span class="mwd-roll-dialog__mod-label">{{label}}</span>
            <span class="mwd-roll-dialog__mod-src">{{source}}</span>
            <span class="mwd-roll-dialog__mod-val">{{value}}</span>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="mwd-roll-dialog__empty">No existing modifiers.</div>
    {{/if}}

    <div class="mwd-roll-dialog__manual-header">
      <div class="mwd-roll-dialog__panel-subtitle">Manual Modifiers</div>
      <button type="button" class="mwd-roll-dialog__btn" data-action="addManual">Add</button>
    </div>

    <div class="mwd-roll-dialog__manual">
      {{#each manual}}
        <div class="mwd-roll-dialog__manual-row">
          <input
            type="text"
            class="mwd-roll-dialog__manual-label"
            value="{{label}}"
            data-action="setManualValue"
            data-id="{{id}}"
            data-field="label"
          />
            <div class="mwd-roll-dialog__manual-stepper">
              {{> "mwd.v2.ui.mod-stepper" id=id action="setManualStepper" steps=steps}}
            </div>

          <button
            type="button"
            class="mwd-roll-dialog__btn mwd-roll-dialog__btn--icon"
            title="Remove"
            data-action="removeManual"
            data-id="{{id}}"
          >✕</button>
        </div>
      {{/each}}
    </div>
  </div>

{{#unless (eq intent "edge")}}
<div class="mwd-roll-dialog__panel">
  <div class="mwd-roll-dialog__panel-title">Edge & Risk</div>

  <label class="mwd-roll-dialog__check">
  <input type="checkbox" {{checked toggles.useEdge}} data-action="toggleCheckbox" data-key="useEdge" />
  <span>
    Use Edge
    {{#if toggles.useEdge}}
      {{#if edge.selectedLabel}}
        <span class="mwd-roll-dialog__edge-selected">({{edge.selectedLabel}})</span>
      {{else}}
        <span class="mwd-roll-dialog__edge-selected is-missing">(choose pool)</span>
      {{/if}}
    {{/if}}
  </span>
</label>


  {{!-- NEW: pool choice, only if Edge applies --}}
  {{#if edge.domain}}
    {{#if toggles.useEdge}}
      <div class="mwd-roll-dialog__edge-pools">
        {{#each edge.choices as |c|}}
          <button type="button"
                  class="mwd-edge-pool {{#if c.selected}}is-selected{{/if}}"
                  data-action="setEdgePrePool"
                  data-pool-key="{{c.key}}">
            {{c.label}} ({{c.available}})
          </button>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}

</div>
{{/unless}}



  <footer class="mwd-roll-dialog__footer">
    <button type="button" class="mwd-roll-dialog__btn" data-action="cancel">Cancel</button>
    <button type="button" class="mwd-roll-dialog__btn mwd-roll-dialog__btn--primary" data-action="submit">ROLL</button>
  </footer>

</section>
