{{#> "mwd.v2.actor._sheet-root"}}
  <section class="panel">
    <h3>Attributes</h3>
    <div class="attributes-row">
      <div class="attribute">
        <label for="system.attributes.strength.value">Strength</label>
        <input id="system.attributes.strength.value" type="number"
               name="system.attributes.strength.value"
               value="{{system.attributes.strength.value}}"
               data-dtype="Number" min="0"
               {{#unless editing}}disabled{{/unless}} />
      </div>
      {{!-- repeat other attributes --}}
    </div>
  </section>

  {{!-- temporarily keep your existing partials --}}
  <section class="panel">
    <h3>Skills</h3>
    {{> "mwd.actor.parts.skills"}}
  </section>
{{/ "mwd.v2.actor._sheet-root"}}