{{!--
templates/v2/actor/_sheet-root.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<form class="{{cssClass}} mwd-sheet" data-application-part="sheet" autocomplete="off">
  <header class="sheet-header">
    <div class="header-left">
      <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" />
      <div class="mwd-sheet__title-block">
        <h1 class="name">
          {{#if editable}}
            <input name="name" type="text" value="{{actor.name}}" data-edit-field="staged"/>
          {{else}}
            {{actor.name}}
          {{/if}}
        </h1>
        {{#if machineHeader.enabled}}
          <div class="mwd-sheet__subtitle">
            {{#if editable}}
              <input
                name="{{machineHeader.path}}"
                type="text"
                value="{{machineHeader.model}}"
                placeholder="{{machineHeader.placeholder}}"
                data-edit-field="staged"
              />
            {{else if machineHeader.model}}
              {{machineHeader.model}}
            {{/if}}
          </div>
        {{/if}}
      </div>
    </div>

    <div class="header-right">
      {{#if editable}}
        {{> "mwd.common.view-mode"}}
      {{/if}}
    </div>
  </header>

  <section class="sheet-body">
    {{> @partial-block}}
  </section>
</form>
