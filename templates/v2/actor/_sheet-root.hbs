{{!--
templates/v2/actor/_sheet-root.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<form class="{{cssClass}} mwd-sheet" data-application-part="sheet" autocomplete="off">
  <header class="sheet-header">
    <div class="header-left">
      <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" />
      <div class="mwd-sheet__title-block">
        <h1 class="name">
          {{#if editable}}
            <input name="name" type="text" value="{{actor.name}}" data-edit-field="staged"/>
          {{else}}
            {{actor.name}}
          {{/if}}
        </h1>
        {{#if machineHeader.enabled}}
          <div class="mwd-sheet__subtitle">
            {{#if editable}}
              <input
                name="{{machineHeader.path}}"
                type="text"
                value="{{machineHeader.model}}"
                placeholder="{{machineHeader.placeholder}}"
                data-edit-field="staged"
              />
              <span class="mwd-sheet__cbill-group">
                <span class="mwd-sheet__cbill-label">Cost:</span>
                <input
                  class="mwd-sheet__cbill-input"
                  name="{{machineHeader.cbillPath}}"
                  type="text"
                  inputmode="numeric"
                  value="{{machineHeader.cbillDisplay}}"
                  data-dtype="number"
                  placeholder="0"
                  data-edit-field="staged"
                />
                <span class="mwd-sheet__cbill-symbol" aria-hidden="true">Ꞓ</span>
              </span>
            {{else}}
              {{#if machineHeader.model}}
                <span>{{machineHeader.model}}</span>
              {{/if}}
              {{#if machineHeader.cbillCost}}
                <span class="mwd-sheet__cbill-group mwd-sheet__cbill-group--readonly">
                  <span class="mwd-sheet__cbill-label">Cost:</span>
                  <span class="mwd-sheet__cbill">{{machineHeader.cbillDisplay}}</span>
                  <span class="mwd-sheet__cbill-symbol" aria-hidden="true">Ꞓ</span>
                </span>
              {{/if}}
            {{/if}}
          </div>
        {{/if}}
      </div>
    </div>

    <div class="header-right">
      {{#if editable}}
        {{> "mwd.common.view-mode"}}
      {{/if}}
    </div>
  </header>

  <section class="sheet-body">
    {{> @partial-block}}
  </section>
</form>
