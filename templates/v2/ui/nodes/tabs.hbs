<div class="csb-tabs" data-group="{{node.group}}" data-default="{{node.default}}">
  <nav class="csb-tab-bar">
    {{#each node.tabs as |t|}}
      <a
        class="csb-tab-link"
        data-action="tab"
        data-tab="{{t.id}}">
        {{t.label}}
      </a>
    {{/each}}
  </nav>

  <section class="csb-tab-panels">
    {{#each node.tabs as |t|}}
      <div class="csb-tab-panel" data-tab="{{t.id}}">
        {{#each t.children as |child|}}
          {{> (lookup child "template") node=child}}
        {{/each}}
      </div>
    {{/each}}
  </section>
</div>
