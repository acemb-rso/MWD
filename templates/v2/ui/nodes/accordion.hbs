{{!--
templates/v2/ui/nodes/accordion.hbs
Purpose: Renders vertical accordion groups for layout JSON.
How it fits: Provides a shared decluttering container alongside stack and tabs.
--}}


<div class="csb-accordion {{#if node.classes}}{{join node.classes " "}}{{/if}}" data-group="{{node.group}}" data-default="{{node.default}}">
  {{#each node.sections as |section|}}
    <section class="csb-accordion__section" data-section="{{section.id}}">
      <h3 class="csb-accordion__heading">
        <button type="button"
                class="csb-accordion__trigger"
                data-action="accordion"
                data-group="{{../node.group}}"
                data-section="{{section.id}}"
                aria-expanded="false"
                aria-controls="csb-accordion-panel-{{../node.group}}-{{section.id}}">
          {{#if (or section.summaryPath section.summary)}}
            <span class="mwd-accordion__trigger-copy">
              <span class="csb-accordion__label">{{#if section.label}}{{section.label}}{{else}}{{section.id}}{{/if}}</span>
              {{#if section.summaryPath}}
                {{#with (getProperty @root section.summaryPath) as |summary|}}
                  {{#if summary}}
                    <span class="mwd-accordion__summary">{{summary}}</span>
                  {{/if}}
                {{/with}}
              {{else if section.summary}}
                <span class="mwd-accordion__summary">{{section.summary}}</span>
              {{/if}}
            </span>
          {{else}}
            <span class="csb-accordion__label">{{#if section.label}}{{section.label}}{{else}}{{section.id}}{{/if}}</span>
          {{/if}}
          <span class="csb-accordion__chevron" aria-hidden="true"></span>
        </button>
      </h3>

      <div class="csb-accordion__panel" id="csb-accordion-panel-{{../node.group}}-{{section.id}}">
        {{#each section.children as |child|}}
          {{> (lookup child "template") node=child}}
        {{/each}}
      </div>
    </section>
  {{/each}}
</div>
