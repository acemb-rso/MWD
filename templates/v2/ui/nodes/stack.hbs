{{!--
templates/v2/ui/nodes/stack.hbs
Purpose: Renders collections with `each` blocks. Contains conditional display logic.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="{{#if node.classes}}{{join node.classes " "}}{{/if}}">
  {{#each node.children as |child|}}
    {{> (lookup child "template") node=child}}
  {{/each}}
</div>
