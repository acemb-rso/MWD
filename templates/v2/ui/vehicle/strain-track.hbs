{{!--
templates/v2/ui/vehicle/strain-track.hbs
Purpose: Displays vehicle operational strain generated by Redline.
How it fits: Vehicle strain is distinct from BattleMech heat and stays display-only here.
--}}

{{#if vehicleSheet.strain}}
  <section class="mwd-heat-track mwd-vehicle-strain">
    <div class="mwd-item-hero">
      <div class="mwd-item-hero__stat{{#if vehicleSheet.strain.pendingGenerated}} is-orange{{/if}}">
        <span class="mwd-item-hero__label">Strain</span>
        <span class="mwd-item-hero__value">{{vehicleSheet.strain.value}} / {{vehicleSheet.strain.max}}</span>
      </div>
      <div class="mwd-item-hero__stat">
        <span class="mwd-item-hero__label">State</span>
        <span class="mwd-item-hero__value">{{vehicleSheet.strain.label}}</span>
      </div>
      <button
        type="button"
        class="mwd-item-hero__stat mwd-item-hero__stat--button is-action"
        data-action="openStrainDialog"
        title="{{vehicleSheet.strain.doctrine}}">
        <span class="mwd-item-hero__label">Pending</span>
        <span class="mwd-item-hero__value">{{vehicleSheet.strain.pendingGenerated}}</span>
      </button>
    </div>

    <div class="mwd-heat-track__segments">
      {{#each vehicleSheet.strain.segments as |segment|}}
        <span
          class="mwd-heat-track__segment is-{{segment.band}}{{#if segment.filled}} is-filled{{/if}}{{#if segment.current}} is-current{{/if}}"
          title="{{segment.value}} | {{segment.bandLabel}}">
        </span>
      {{/each}}
    </div>

    <p class="mwd-hint">{{vehicleSheet.strain.doctrine}}</p>
  </section>
{{/if}}
