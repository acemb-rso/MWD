{{!--
templates/v2/ui/vehicle/ew-panel.hbs
Purpose: Shared machine EW panel for vehicle and BattleMech V2 sheets.
How it fits: Renders a dumb view model from vehicleSheet.ewPanel and launches shared EW intents.
--}}

<div class="mwd-inv mwd-ew-panel">
  <p class="mwd-hint">{{vehicleSheet.ewPanel.helpText}}</p>

  {{#if vehicleSheet.ewPanel.rows.length}}
    <div class="mwd-records mwd-records--inventory">
      {{#each vehicleSheet.ewPanel.rows as |row|}}
        <article class="mwd-record mwd-record--ew">
          <div class="mwd-record__header">
            <div class="mwd-record__main">
              <div class="mwd-record__topline">
                <div class="mwd-record__title">{{row.tokenName}}</div>
                <div class="mwd-record__stats">
                  <span class="mwd-record__stat is-strong">
                    <span class="mwd-record__stat-label">State</span>
                    <span class="mwd-record__stat-value">{{row.detectionStateLabel}}</span>
                  </span>
                  {{#if row.hasRange}}
                    <span class="mwd-record__stat">
                      <span class="mwd-record__stat-label">Range</span>
                      <span class="mwd-record__stat-value">{{row.rangeBandLabel}}</span>
                    </span>
                    <span class="mwd-record__stat">
                      <span class="mwd-record__stat-label">Dist</span>
                      <span class="mwd-record__stat-value">{{row.distanceLabel}}</span>
                    </span>
                  {{/if}}
                  {{#if row.hasPacket}}
                    <span class="mwd-record__stat">
                      <span class="mwd-record__stat-label">Packet</span>
                      <span class="mwd-record__stat-value">+{{row.packetValue}}</span>
                    </span>
                  {{/if}}
                  {{#if row.hasPacketCap}}
                    <span class="mwd-record__stat">
                      <span class="mwd-record__stat-label">Cap</span>
                      <span class="mwd-record__stat-value">+{{row.packetCap}}</span>
                    </span>
                  {{/if}}
                  {{#if row.hasTrackingPenalty}}
                    <span class="mwd-record__stat">
                      <span class="mwd-record__stat-label">Penalty</span>
                      <span class="mwd-record__stat-value">-{{row.trackingPenalty}}</span>
                    </span>
                  {{/if}}
                </div>
              </div>

              <div class="mwd-record__subtitle">{{row.acquireHint}}</div>
              <div class="mwd-record__subtitle">{{row.targetHint}}</div>

              <div class="mwd-record__tags">
                <span class="mwd-record__tag{{#if row.canAcquire}} is-on{{/if}}">Acquire {{#if row.canAcquire}}Ready{{else}}Locked{{/if}}</span>
                <span class="mwd-record__tag{{#if row.canTarget}} is-on{{/if}}">Target {{#if row.canTarget}}Ready{{else}}Waiting{{/if}}</span>
              </div>
            </div>

            <div class="mwd-record__actions">
              <button
                type="button"
                class="mwd-inv__add-btn{{#unless row.acquireAction.enabled}} is-disabled{{/unless}}"
                data-action="ewAcquire"
                data-target-token-id="{{row.targetTokenId}}"
                data-target-token-uuid="{{row.targetTokenUuid}}"
                title="{{row.acquireAction.title}}"
                {{#unless row.acquireAction.enabled}}disabled{{/unless}}>
                <i class="fas fa-satellite-dish"></i> {{row.acquireAction.label}}
              </button>
              <button
                type="button"
                class="mwd-inv__add-btn{{#unless row.targetAction.enabled}} is-disabled{{/unless}}"
                data-action="ewTarget"
                data-target-token-id="{{row.targetTokenId}}"
                data-target-token-uuid="{{row.targetTokenUuid}}"
                title="{{row.targetAction.title}}"
                {{#unless row.targetAction.enabled}}disabled{{/unless}}>
                <i class="fas fa-crosshairs"></i> {{row.targetAction.label}}
              </button>
            </div>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="mwd-inv__empty">{{vehicleSheet.ewPanel.emptyState}}</div>
  {{/if}}
</div>
