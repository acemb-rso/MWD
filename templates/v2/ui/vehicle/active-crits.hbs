{{!--
templates/v2/ui/vehicle/active-crits.hbs
Purpose: Renders active machine critical effects prepared by the vehicle sheet.
How it fits: Keeps remediation buttons declarative while intent resolution stays in JS.
--}}

{{#if vehicleSheet.activeCrits.length}}
  <div class="mwd-records mwd-records--inventory">
    {{#each vehicleSheet.activeCrits as |crit|}}
      <article class="mwd-record mwd-record--crit">
        <div class="mwd-record__header">
          <div class="mwd-record__main">
            <div class="mwd-record__topline">
              <div class="mwd-record__title">{{crit.label}}</div>
              <div class="mwd-record__stats">
                <span class="mwd-record__stat is-strong">
                  <span class="mwd-record__stat-label">Location</span>
                  <span class="mwd-record__stat-value">{{crit.locationLabel}}</span>
                </span>
              </div>
            </div>
            {{#if crit.detail}}
              <div class="mwd-record__subtitle">{{crit.detail}}</div>
            {{/if}}
          </div>
          {{#if crit.remediable}}
            <div class="mwd-record__actions">
              <button
                type="button"
                class="mwd-record__icon-btn"
                data-action="machineCritRemedy"
                data-machine-actor-uuid="{{crit.machineActorUuid}}"
                data-crit-id="{{crit.id}}"
                data-remedy-key="{{crit.remedyKey}}"
                title="{{crit.remedyLabel}}">
                <i class="fas fa-wrench"></i>
              </button>
            </div>
          {{/if}}
        </div>
      </article>
    {{/each}}
  </div>
{{else}}
  <div class="mwd-inv__empty">No active machine criticals.</div>
{{/if}}
