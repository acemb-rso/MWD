{{!--
templates/v2/ui/vehicle/summary-bar.hbs
Purpose: Renders the top-level vehicle or BattleMech hero stats plus any prepared alerts.
How it fits: Shared by both vehicle-scale V2 sheets.
--}}

<section class="mwd-item-hero">
  {{#each vehicleSheet.summaryStats as |stat|}}
    <div class="mwd-item-hero__stat{{#if stat.tone}} is-{{stat.tone}}{{/if}}"{{#if stat.title}} title="{{stat.title}}"{{/if}}>
      <span class="mwd-item-hero__label">{{stat.label}}</span>
      {{#if stat.hasParts}}
        <span class="mwd-item-hero__parts">
          {{#each stat.parts as |part|}}
            <span class="mwd-item-hero__part{{#if part.tone}} is-{{part.tone}}{{/if}}"{{#if part.title}} title="{{part.title}}"{{/if}}>
              <span class="mwd-item-hero__part-label">{{part.label}}</span>
              <span class="mwd-item-hero__part-value">{{part.value}}</span>
            </span>
          {{/each}}
        </span>
      {{else}}
        <span class="mwd-item-hero__value">{{stat.value}}</span>
      {{/if}}
    </div>
  {{/each}}
</section>

{{#if vehicleSheet.statusAction}}
  <div class="mwd-item-toolbar" style="margin-top: 0.5rem;">
    <button
      type="button"
      data-action="toggleStatuses"
      data-action-disabled="{{#if vehicleSheet.statusAction.disabled}}true{{else}}false{{/if}}"
      data-action-reason="{{vehicleSheet.statusAction.reason}}"
      {{#if vehicleSheet.statusAction.disabled}}disabled{{/if}}
    >
      <i class="fa-solid fa-heart-pulse"></i>
      {{vehicleSheet.statusAction.label}}
    </button>
  </div>
{{/if}}

{{#if vehicleSheet.alerts.length}}
  <div class="mwd-inv__warnings">
    {{#each vehicleSheet.alerts as |alert|}}
      <div class="mwd-inv__warning{{#if alert.tone}} is-{{alert.tone}}{{/if}}">{{alert.text}}</div>
    {{/each}}
  </div>
{{/if}}
