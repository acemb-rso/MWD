{{!--
templates/v2/ui/character/inventory-record.hbs
Purpose: Renders a single compact inventory record row with optional accordion details.
How it fits: Shared by the character inventory section partials.
--}}


<article class="mwd-record{{#if record.isExpanded}} is-expanded{{/if}}{{#if record.equipped}} is-equipped{{/if}}{{#if record.isPrimary}} is-primary{{/if}}{{#if record.className}} {{record.className}}{{/if}}"
         data-item-id="{{record.id}}"
         data-accordion-id="{{record.accordionId}}"
         {{#if record.hardpointId}}data-hardpoint-id="{{record.hardpointId}}"{{/if}}
         {{#if record.id}}draggable="true"{{/if}}>
  <div class="mwd-record__header">
    <button type="button"
            class="mwd-record__toggle"
            data-action="toggleInventoryAccordion"
            data-accordion-id="{{record.accordionId}}"
            title="{{#if record.isExpanded}}Hide details{{else}}Show details{{/if}}">
      <i class="fas {{#if record.isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
    </button>

    {{#if supportsAttack}}
      <button type="button"
              class="mwd-record__media mwd-record__media--roll{{#if record.attackDisabled}} is-disabled{{/if}}"
              data-action="attackWeapon"
              data-weapon-attack-uuid="{{record.attackUuid}}"
              data-roll='{{record.attackRoll}}'
              title="{{#if record.attackDisabled}}{{record.attackDisabledReason}}{{else}}Attack with {{record.name}} or drag to the hotbar{{/if}}"
              aria-label="{{#if record.attackDisabled}}{{record.attackDisabledReason}}{{else}}Attack with {{record.name}}{{/if}}"
              draggable="true"
              {{#if record.attackDisabled}}data-action-disabled="true" data-action-reason="{{record.attackDisabledReason}}" aria-disabled="true"{{/if}}>
        <img class="mwd-record__thumb" src="{{record.img}}" alt="" draggable="false">
      </button>
    {{else}}
      {{#if record.isEmptyHardpoint}}
        <div class="mwd-record__media{{#if record.mediaClassName}} {{record.mediaClassName}}{{/if}}">
          <div class="mwd-record__slot-glyph" aria-hidden="true">
            <span class="mwd-record__slot-glyph-main">{{record.slotTypeCode}}</span>
            <span class="mwd-record__slot-glyph-sub">{{record.slotSizeCode}}</span>
            <span class="mwd-record__slot-glyph-open">{{record.slotOpenLabel}}</span>
          </div>
        </div>
      {{else if record.createHardpointItem}}
        <div class="mwd-record__media{{#if record.mediaClassName}} {{record.mediaClassName}}{{/if}}">
          <img class="mwd-record__thumb" src="{{record.img}}" alt="">
        </div>
      {{else}}
        <button type="button"
                class="mwd-record__media{{#if record.mediaClassName}} {{record.mediaClassName}}{{/if}}"
                data-action="editOwnedItem"
                title="Open {{record.name}}">
          <img class="mwd-record__thumb" src="{{record.img}}" alt="">
        </button>
      {{/if}}
    {{/if}}

    <div class="mwd-record__main">
      <div class="mwd-record__topline">
        {{#if record.id}}
          <button type="button" class="mwd-record__title-btn" data-action="editOwnedItem">{{record.name}}</button>
        {{else}}
          <div class="mwd-record__title-btn">{{record.name}}</div>
        {{/if}}
        <div class="mwd-record__stats">
          {{#each record.summaryStats as |stat|}}
            <span class="mwd-record__stat{{#if stat.emphasis}} is-{{stat.emphasis}}{{/if}}">
              <span class="mwd-record__stat-label">{{stat.label}}</span>
              <span class="mwd-record__stat-value">{{stat.value}}</span>
            </span>
          {{/each}}

          {{#if record.canAdjustQuantity}}
            <span class="mwd-record__stat">
              <span class="mwd-record__stat-value">
                <button type="button"
                        class="mwd-record__icon-btn"
                        data-action="adjustGearQuantity"
                        data-delta="-1"
                        title="Decrease quantity">
                  <i class="fas fa-minus"></i>
                </button>
                <button type="button"
                        class="mwd-record__icon-btn"
                        data-action="adjustGearQuantity"
                        data-delta="1"
                        title="Increase quantity">
                  <i class="fas fa-plus"></i>
                </button>
              </span>
            </span>
          {{/if}}
        </div>
      </div>

      {{#if record.subtitle}}
        <div class="mwd-record__subtitle">{{record.subtitle}}</div>
      {{/if}}

      {{#if record.detailTags.length}}
        <div class="mwd-record__tags">
          {{#each record.detailTags as |tag|}}
            <span class="mwd-record__tag">{{tag.label}}</span>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <div class="mwd-record__actions">
      {{#if supportsEquip}}
        <button type="button"
                class="mwd-record__icon-btn {{#if record.equipped}}is-on{{/if}}"
                data-action="toggleOwnedItemEquipped"
                title="{{#if record.equipped}}Unequip{{else}}Equip{{/if}}">
          <i class="fas {{#if record.equipped}}fa-check-circle{{else}}fa-circle{{/if}}"></i>
        </button>
      {{/if}}

      {{#if supportsPrimary}}
        <button type="button"
                class="mwd-record__icon-btn {{#if record.isPrimary}}is-on is-star{{/if}}"
                data-action="setOwnedItemPrimary"
                title="{{#if record.isPrimary}}Clear primary{{else}}Set as primary{{/if}}">
          <i class="{{#if record.isPrimary}}fas{{else}}far{{/if}} fa-star"></i>
        </button>
      {{/if}}

      {{#if record.machineAttack}}
        <button type="button"
                class="mwd-record__icon-btn"
                data-action="machineWeaponAttack"
                data-item-id="{{record.machineAttack.itemId}}"
                title="{{record.machineAttack.label}}">
          <i class="fas fa-crosshairs"></i>
        </button>
      {{/if}}

      {{#if record.supportsModuleActivation}}
        <button type="button"
                class="mwd-record__icon-btn {{#if record.moduleActive}}is-on{{/if}}"
                data-action="toggleAssetModuleActive"
                data-item-id="{{record.id}}"
                title="{{#if record.moduleActive}}Deactivate module{{else}}Activate module{{/if}}"
                {{#unless record.moduleReady}}disabled{{/unless}}>
          <i class="fas {{#if record.moduleActive}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
        </button>
      {{/if}}

      {{#if record.createHardpointItem}}
        <button type="button"
                class="mwd-record__icon-btn"
                data-action="createHardpointItem"
                data-hardpoint-id="{{record.createHardpointItem.hardpointId}}"
                data-item-type="{{record.createHardpointItem.itemType}}"
                title="{{record.createHardpointItem.label}}">
          <i class="fas fa-plus"></i>
        </button>
      {{/if}}

      {{#if record.assignHardpointItem}}
        <button type="button"
                class="mwd-record__icon-btn"
                data-action="assignHardpointItem"
                data-hardpoint-id="{{record.assignHardpointItem.hardpointId}}"
                title="{{record.assignHardpointItem.label}}">
          <i class="fas fa-link"></i>
        </button>
      {{/if}}

      {{#if record.clearHardpointItem}}
        <button type="button"
                class="mwd-record__icon-btn {{record.clearHardpointItem.buttonClassName}}"
                data-action="clearHardpointItem"
                data-hardpoint-id="{{record.clearHardpointItem.hardpointId}}"
                title="{{record.clearHardpointItem.hint}}{{#unless record.clearHardpointItem.hint}}{{record.clearHardpointItem.label}}{{/unless}}">
          <i class="fas {{record.clearHardpointItem.icon}}"></i>
        </button>
      {{/if}}

      {{#if record.id}}
        <button type="button"
                class="mwd-record__icon-btn"
                data-action="editOwnedItem"
                title="Open">
          <i class="fas fa-pen"></i>
        </button>

        {{#unless record.suppressDeleteButton}}
          <button type="button"
                  class="mwd-record__icon-btn is-danger"
                  data-action="deleteOwnedItem"
                  title="Delete">
            <i class="fas fa-times"></i>
          </button>
        {{/unless}}
      {{/if}}
    </div>
  </div>

  {{#if record.isExpanded}}
    <div class="mwd-record__body">
      {{#if record.detailRows.length}}
        <div class="mwd-record__details">
          {{#each record.detailRows as |row|}}
            <div class="mwd-record__detail">
              <span class="mwd-record__detail-label">{{row.label}}</span>
              <span class="mwd-record__detail-value">{{row.value}}</span>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if record.detailText}}
        <div class="mwd-record__text">{{record.detailText}}</div>
      {{/if}}

      {{#if record.clearHardpointItem.inlineLabel}}
        <div class="mwd-record__body-actions">
          <button type="button"
                  class="mwd-record__body-btn is-danger"
                  data-action="clearHardpointItem"
                  data-hardpoint-id="{{record.clearHardpointItem.hardpointId}}"
                  title="{{record.clearHardpointItem.hint}}{{#unless record.clearHardpointItem.hint}}{{record.clearHardpointItem.label}}{{/unless}}">
            <i class="fas {{record.clearHardpointItem.icon}}"></i>
            <span>{{record.clearHardpointItem.inlineLabel}}</span>
          </button>
        </div>
      {{/if}}
    </div>
  {{/if}}
</article>
