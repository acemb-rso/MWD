{{!--
templates/v2/ui/character/skills-toolbar.hbs
Purpose: Renders the subtle Skills tab display option.
How it fits: Lets the character sheet hide skills that only roll their linked attribute.
--}}

<div class="mwd-skills-toolbar">
  {{#> "mwd.v2.components.checkbox" classes="mwd-checkbox--inline mwd-skills-toolbar__toggle" label="Hide blank skills" controlFirst=true}}
    <input type="checkbox"
           data-action="toggleStatOnlySkills"
           title="Hide rating 0 skills with no modifiers"
           {{checked skillDisplayOptions.hideStatOnly}} />
  {{/ "mwd.v2.components.checkbox"}}
</div>
