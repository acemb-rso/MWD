{{!--
templates/v2/ui/character/status-dashboard.hbs
Purpose: Renders collections with `each` blocks. Contains conditional display logic. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="mwd-combat-dashboard">
  {{#if combatDashboard.inactiveReason}}
    <div class="mwd-combat-dashboard__notice">{{combatDashboard.inactiveReason}}</div>
  {{/if}}

  <div class="mwd-combat-dashboard__grid">
    <div class="mwd-combat-dashboard__card">
      <div class="mwd-combat-dashboard__label">{{combatDashboard.targeting.heading}}</div>
      <div class="mwd-combat-dashboard__value">{{combatDashboard.targeting.primaryLabel}}</div>

      {{#if combatDashboard.targeting.detailRows.length}}
        <div class="mwd-combat-dashboard__detail-list">
          {{#each combatDashboard.targeting.detailRows as |row|}}
            <div class="mwd-combat-dashboard__detail-row">
              <span>{{row.label}}</span>
              <strong>{{row.value}}</strong>
            </div>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <div class="mwd-combat-dashboard__card">
      <div class="mwd-combat-dashboard__label">Roll Impact</div>
      <div class="mwd-combat-dashboard__value mwd-combat-dashboard__value--impact">{{combatDashboard.rollImpact.totalLabel}}</div>

      <div class="mwd-combat-dashboard__modifier-list">
        {{#each combatDashboard.rollImpact.entries as |modifier|}}
          <div class="mwd-combat-dashboard__modifier">
            <span>{{modifier.label}}</span>
            <strong>{{modifier.value}}</strong>
          </div>
        {{/each}}
      </div>
    </div>
  </div>

  <div class="mwd-combat-dashboard__columns">
    <div class="mwd-combat-dashboard__section">
      <div class="mwd-combat-dashboard__section-title">States</div>
      <div class="mwd-combat-dashboard__chips">
        {{#if combatDashboard.states.length}}
          {{#each combatDashboard.states as |state|}}
            <span class="chip mwd-combat-dashboard__chip mwd-combat-dashboard__chip--state">{{state.label}}</span>
          {{/each}}
        {{else}}
          <span class="mwd-combat-dashboard__empty">No active states.</span>
        {{/if}}
      </div>
    </div>

    <div class="mwd-combat-dashboard__section">
      <div class="mwd-combat-dashboard__section-title">Effects</div>
      <div class="mwd-combat-dashboard__chips">
        {{#if combatDashboard.effects.length}}
          {{#each combatDashboard.effects as |effect|}}
            <span class="chip mwd-combat-dashboard__chip">{{effect.label}}</span>
          {{/each}}
        {{else}}
          <span class="mwd-combat-dashboard__empty">No active effects.</span>
        {{/if}}
      </div>
    </div>
  </div>
</div>
