{{!--
templates/v2/ui/character/bio-history.hbs
Purpose: Renders the character history rich-text editor field.
How it fits: Included by the Bio tab History panel in the character sheet.
--}}

<div class="mwd-bio-history">
  <div class="editor">
    {{formInput bio.fields.history
      name="system.biography.history"
      value=system.biography.history
      enriched=bio.enrichedHistory
      toggled=true}}
  </div>
</div>
