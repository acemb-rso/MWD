{{!--
templates/v2/ui/character/advancement.hbs
Purpose: Presents character build validation and XP purchase intents.
--}}

<div class="mwd-advancement">
  {{#unless advancement.open}}
    <button type="button"
            class="mwd-advancement__open"
            data-action="openAdvancementMode"
            title="Open Advancement">
      <i class="fas fa-arrow-up-right-dots"></i> Open Advancement
    </button>
  {{else}}
    <div class="mwd-advancement__header">
      <div class="mwd-advancement__xp">
        <span><strong>{{advancement.xp.available}}</strong> Available</span>
        <span>{{advancement.xp.earned}} Earned</span>
        <span>{{advancement.xp.spent}} Spent</span>
      </div>
      <button type="button" data-action="closeAdvancementMode" title="Close Advancement">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <section class="mwd-advancement__section">
      <h4>Starting Build: {{advancement.build.tier.label}}</h4>
      <div class="mwd-advancement__budget-grid">
        {{#each advancement.build.categories as |category|}}
          <div class="mwd-advancement-budget mwd-advancement-budget--{{category.status}}">
            <span>{{category.label}}</span>
            <strong>{{category.used}} / {{category.budget}}</strong>
          </div>
        {{/each}}
      </div>
      {{#if advancement.build.warnings.length}}
        <ul class="mwd-advancement__warnings">
          {{#each advancement.build.warnings as |warning|}}
            <li>{{warning}}</li>
          {{/each}}
        </ul>
      {{else}}
        <div class="mwd-advancement__ok">Build budgets complete.</div>
      {{/if}}
    </section>

    <section class="mwd-advancement__section">
      <h4>Purchase</h4>
      <div class="mwd-advancement__actions">
        <button type="button" data-action="openAdvancementDialog" data-dialog="attribute">
          <i class="fas fa-fist-raised"></i> Raise Attribute
        </button>
        <button type="button" data-action="openAdvancementDialog" data-dialog="skill">
          <i class="fas fa-book-open"></i> Raise Skill
        </button>
        <button type="button" data-action="openAdvancementDialog" data-dialog="edgePool">
          <i class="fas fa-bolt"></i> Raise Edge Pool
        </button>
        <button type="button" data-action="openAdvancementDialog" data-dialog="specialization">
          <i class="fas fa-star"></i> Manage Specialization
        </button>
        <button type="button" data-action="openAdvancementDialog" data-dialog="traitAdd">
          <i class="fas fa-plus"></i> Buy Positive Trait
        </button>
        {{#if advancement.negativeTraits.length}}
          <button type="button" data-action="openAdvancementDialog" data-dialog="traitRemove">
            <i class="fas fa-minus-circle"></i> Remove Negative Trait
          </button>
        {{/if}}
      </div>
    </section>
  {{/unless}}
</div>
