{{!--
templates/v2/ui/character/advancement.hbs
Purpose: Presents character build validation and XP purchase intents.
--}}

<div class="mwd-advancement">
  {{#unless advancement.open}}
    <button type="button"
            class="mwd-advancement__open"
            data-action="openAdvancementMode"
            title="Open Advancement">
      <i class="fas fa-arrow-up-right-dots"></i> Open Advancement
    </button>
  {{else}}
    <div class="mwd-advancement__header">
      <div class="mwd-advancement__xp">
        <span><strong>{{advancement.xp.available}}</strong> Available</span>
        <span>{{advancement.xp.earned}} Earned</span>
        <span>{{advancement.xp.spent}} Spent</span>
      </div>
      <button type="button" data-action="closeAdvancementMode" title="Close Advancement">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <section class="mwd-advancement__section">
      <h4>Starting Build: {{advancement.build.tier.label}}</h4>
      <div class="mwd-advancement__budget-grid">
        {{#each advancement.build.categories as |category|}}
          <div class="mwd-advancement-budget mwd-advancement-budget--{{category.status}}">
            <span>{{category.label}}</span>
            <strong>{{category.used}} / {{category.budget}}</strong>
          </div>
        {{/each}}
      </div>
      {{#if advancement.build.warnings.length}}
        <ul class="mwd-advancement__warnings">
          {{#each advancement.build.warnings as |warning|}}
            <li>{{warning}}</li>
          {{/each}}
        </ul>
      {{else}}
        <div class="mwd-advancement__ok">Build budgets complete.</div>
      {{/if}}
    </section>

    <section class="mwd-advancement__section">
      <h4>Attributes</h4>
      <div class="mwd-advancement-list">
        {{#each advancement.attributes as |purchase|}}
          <button type="button"
                  class="mwd-advancement-buy"
                  data-action="commitAdvancementPurchase"
                  data-purchase-type="{{purchase.dataset.type}}"
                  data-purchase-target="{{purchase.dataset.target}}"
                  data-purchase-to="{{purchase.dataset.to}}"
                  title="{{purchase.reason}}"
                  {{#if purchase.disabled}}disabled{{/if}}>
            <span>{{purchase.label}} {{purchase.current}} -> {{purchase.next}}</span>
            <strong>{{purchase.cost}} XP</strong>
          </button>
        {{/each}}
      </div>
    </section>

    <section class="mwd-advancement__section">
      <h4>Skills</h4>
      <div class="mwd-advancement-list">
        {{#each advancement.skills as |purchase|}}
          <div class="mwd-advancement-skill">
            <button type="button"
                    class="mwd-advancement-buy"
                    data-action="commitAdvancementPurchase"
                    data-purchase-type="{{purchase.dataset.type}}"
                    data-purchase-target="{{purchase.dataset.target}}"
                    data-purchase-to="{{purchase.dataset.to}}"
                    title="{{purchase.reason}}"
                    {{#if purchase.disabled}}disabled{{/if}}>
              <span>{{purchase.label}} {{purchase.current}} -> {{purchase.next}}</span>
              <strong>{{purchase.cost}} XP</strong>
            </button>
            <button type="button"
                    class="mwd-advancement-buy mwd-advancement-buy--secondary"
                    data-action="commitAdvancementPurchase"
                    data-purchase-type="{{purchase.specializationDataset.type}}"
                    data-purchase-target="{{purchase.specializationDataset.target}}"
                    title="{{purchase.specializationReason}}"
                    {{#unless purchase.canSpecialize}}disabled{{/unless}}>
              <span>{{purchase.specializationAction}}</span>
              <strong>{{purchase.specializationCost}} XP</strong>
            </button>
          </div>
        {{/each}}
      </div>
    </section>

    <section class="mwd-advancement__section">
      <h4>Edge Pools</h4>
      <div class="mwd-advancement-list">
        {{#each advancement.edgePools as |purchase|}}
          <button type="button"
                  class="mwd-advancement-buy"
                  data-action="commitAdvancementPurchase"
                  data-purchase-type="{{purchase.dataset.type}}"
                  data-purchase-target="{{purchase.dataset.target}}"
                  data-purchase-to="{{purchase.dataset.to}}"
                  title="{{purchase.reason}}"
                  {{#if purchase.disabled}}disabled{{/if}}>
            <span>{{purchase.label}} {{purchase.current}} -> {{purchase.next}}</span>
            <strong>{{purchase.cost}} XP</strong>
          </button>
        {{/each}}
      </div>
    </section>

    <section class="mwd-advancement__section">
      <h4>Traits</h4>
      <div class="mwd-knowledge-skills__add">
        <input type="text" name="mwdTraitName" placeholder="Positive trait name" />
        <button type="button"
                data-action="commitAdvancementPurchase"
                data-purchase-type="traitAdd"
                data-purchase-target="Positive Trait"
                data-purchase-label="Positive Trait">
          <i class="fas fa-plus"></i> Buy Positive Trait ({{advancement.addTraitCost}} XP)
        </button>
      </div>
      {{#if advancement.negativeTraits.length}}
        <div class="mwd-advancement-list">
          {{#each advancement.negativeTraits as |trait|}}
            <button type="button"
                    class="mwd-advancement-buy"
                    data-action="commitAdvancementPurchase"
                    data-purchase-type="{{trait.dataset.type}}"
                    data-purchase-target="{{trait.dataset.target}}"
                    title="{{trait.reason}}"
                    {{#if trait.disabled}}disabled{{/if}}>
              <span>Remove {{trait.name}}</span>
              <strong>{{trait.cost}} XP</strong>
            </button>
          {{/each}}
        </div>
      {{/if}}
    </section>
  {{/unless}}
</div>
