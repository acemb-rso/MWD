                 data-dtype="Number"
                 min="0" />
        {{else}}
          <span class="attribute-value">{{system.attributes.intelligence.value}}</span>
        {{/if}}
      {{/ "mwd.v2.ui.nodes.hexabox"}}
    </div>

    <div class="attribute">
      <label for="system.attributes.willpower.value">Willpower</label>
      {{#> "mwd.v2.ui.nodes.hexabox" node=(hash classes="attribute-hex")}}
