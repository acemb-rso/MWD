<div class="mwd-attributes">
  <div class="attributes-row">

    <div class="attribute">
      <label for="system.attributes.strength.value">Strength</label>
      {{#> "mwd.v2.ui.nodes.hexabox" node=(hash classes="attribute-hex")}}
        {{#if @root.editable}}
          <input id="system.attributes.strength.value"
                 type="number"
                 name="system.attributes.strength.value"
                 value="{{system.attributes.strength.value}}"
                 data-dtype="Number"
                 min="0" />
        {{else}}
          <span class="attribute-value">{{system.attributes.strength.value}}</span>
        {{/if}}
      {{/mwd.v2.ui.nodes.hexabox}}
    </div>

    <div class="attribute">
      <label for="system.attributes.reflexes.value">Reflexes</label>
