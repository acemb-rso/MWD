                 name="system.attributes.reflexes.value"
                 value="{{system.attributes.reflexes.value}}"
                 data-dtype="Number"
                 min="0" />
        {{else}}
          <span class="attribute-value">{{system.attributes.reflexes.value}}</span>
        {{/if}}
      {{/ "mwd.v2.ui.nodes.hexabox"}}
    </div>

