{{!--
templates/v2/ui/placeholders/bio-life-modules.hbs
Purpose: Renders 4 fixed life module slots (Faction, Childhood, Higher Education, Real Life).
How it fits: Included by the Bio tab Life Modules panel in the character sheet.
--}}

<div class="mwd-life-modules">
  {{#each lifeModules as |slot|}}
    <div class="mwd-life-module-slot" data-module-type="{{slot.moduleType}}">
      <span class="mwd-life-module-slot__label">{{slot.label}}</span>
      {{#if slot.item}}
        <div class="mwd-life-module-slot__record">
          <div class="mwd-life-module-slot__summary">
            <span class="mwd-life-module-slot__name">{{slot.item.name}}</span>
            {{#each slot.item.bonusLabels as |bonusLabel|}}
              <span class="mwd-item-note">{{bonusLabel}}</span>
            {{/each}}
            <span class="chip{{#unless slot.item.isActive}} is-muted{{/unless}}">{{slot.item.statusLabel}}</span>
            {{#if slot.item.statusReason}}
              <span class="mwd-item-note">{{slot.item.statusReason}}</span>
            {{/if}}
            {{#each slot.item.warningLabels as |warningLabel|}}
              <span class="mwd-item-note">{{warningLabel}}</span>
            {{/each}}
          </div>
          <div class="mwd-life-module-slot__actions">
            <button type="button"
                    class="mwd-record__icon-btn"
                    data-action="editOwnedItem"
                    data-item-id="{{slot.item.id}}"
                    title="Open {{slot.item.name}}">
              <i class="fas fa-pen"></i>
            </button>
            <button type="button"
                    class="mwd-record__icon-btn is-danger"
                    data-action="deleteOwnedItem"
                    data-item-id="{{slot.item.id}}"
                    title="Remove {{slot.item.name}}">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      {{else}}
        <button type="button"
                class="mwd-life-module-slot__add"
                data-action="createLifeModuleItem"
                data-module-type="{{slot.moduleType}}"
                title="{{slot.emptyState}}"
                {{#unless slot.hasCatalogEntries}}disabled{{/unless}}>
          <i class="fas fa-plus"></i> Add
        </button>
        {{#unless slot.hasCatalogEntries}}
          <div class="mwd-item-note">No catalog entries configured for this slot.</div>
        {{/unless}}
      {{/if}}
    </div>
  {{/each}}
</div>
