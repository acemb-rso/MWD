{{!--
templates/v2/ui/battlemech/loadout-hardpoints.hbs
Purpose: Combines BattleMech hardpoint configuration with mounted-slot assignment.
How it fits: Keeps the full hardpoint workflow inside the loadout tab.
--}}

<div class="mwd-hardpoint-workspace">
  <section class="mwd-hardpoint-workspace__panel">
    <div class="mwd-hardpoint-workspace__header">
      <div>
        <div class="mwd-hardpoint-workspace__title">Loadout Slots</div>
        <div class="mwd-hardpoint-workspace__copy">Create each slot here, then mount mech weapons into those slots below. Slot changes save back to the actor sheet.</div>
      </div>

      {{#if @root.editing}}
        <button type="button" class="mwd-inv__add-btn" data-action="addHardpoint">
          <i class="fas fa-plus"></i> Create Loadout Slot
        </button>
      {{/if}}
    </div>

    {{#if @root.vehicleSheet.hardpoints.length}}
      <div class="mwd-actor-items__list">
        {{#each @root.vehicleSheet.hardpoints as |hardpoint|}}
          <article class="mwd-actor-item">
            <div class="mwd-actor-item__main">
              {{#if @root.editing}}
                <input type="hidden" name="system.mwd.hardpoints.{{hardpoint.index}}.id" value="{{hardpoint.id}}" data-edit-field="staged">
                <input type="hidden" name="system.mwd.hardpoints.{{hardpoint.index}}.itemId" value="{{hardpoint.itemId}}" data-edit-field="staged">
              {{/if}}

              <div class="mwd-actor-field-grid" style="display:grid; gap:0.75rem; grid-template-columns:repeat(4, minmax(0, 1fr));">
                <div class="mwd-field-cluster">
                  <label>Type</label>
                  {{#if @root.editing}}
                    <select name="system.mwd.hardpoints.{{hardpoint.index}}.type" data-edit-field="staged">
                      {{selectOptions hardpoint.typeOptions selected=hardpoint.type valueAttr="value" labelAttr="label" localize=false}}
                    </select>
                  {{else}}
                    <div class="mwd-field-cluster__value">{{hardpoint.typeLabel}}</div>
                  {{/if}}
                </div>

                <div class="mwd-field-cluster">
                  <label>Size</label>
                  {{#if @root.editing}}
                    <select name="system.mwd.hardpoints.{{hardpoint.index}}.size" data-edit-field="staged">
                      {{selectOptions hardpoint.sizeOptions selected=hardpoint.size valueAttr="value" labelAttr="label" localize=false}}
                    </select>
                  {{else}}
                    <div class="mwd-field-cluster__value">{{hardpoint.sizeLabel}}</div>
                  {{/if}}
                </div>

                <div class="mwd-field-cluster">
                  <label>Location</label>
                  {{#if @root.editing}}
                    <select name="system.mwd.hardpoints.{{hardpoint.index}}.location" data-edit-field="staged">
                      {{selectOptions hardpoint.locationOptions selected=hardpoint.location valueAttr="value" labelAttr="label" localize=false}}
                    </select>
                  {{else}}
                    <div class="mwd-field-cluster__value">{{hardpoint.locationLabel}}</div>
                  {{/if}}
                </div>

                <div class="mwd-field-cluster">
                  <label>Occupancy</label>
                  <div class="mwd-field-cluster__value">{{hardpoint.occupancyLabel}}</div>
                </div>
              </div>
            </div>

            {{#if @root.editing}}
              <div class="mwd-actor-item__actions">
                <button type="button" data-action="deleteHardpoint" data-hardpoint-index="{{hardpoint.index}}">Delete</button>
              </div>
            {{/if}}
          </article>
        {{/each}}
      </div>
    {{else}}
      <div class="mwd-actor-items__empty">No hardpoints configured.</div>
    {{/if}}
  </section>

  <section class="mwd-hardpoint-workspace__panel">
    <div class="mwd-hardpoint-workspace__header">
      <div>
        <div class="mwd-hardpoint-workspace__title">Mounted Slots</div>
        <div class="mwd-hardpoint-workspace__copy">Weapons only exist here as mounted slot equipment. Drag a mech weapon item onto an open slot or create one directly for that slot.</div>
      </div>
    </div>

    {{#with @root.vehicleSheet.sections.slots as |section|}}
      {{#if section.records.length}}
        <div class="mwd-records mwd-records--inventory">
          {{#each section.records as |record|}}
            {{> "mwd.v2.ui.character.inventory-record" record=record}}
          {{/each}}
        </div>
      {{else}}
        <div class="mwd-inv__empty">{{section.emptyLabel}}</div>
      {{/if}}
    {{/with}}
  </section>
</div>
