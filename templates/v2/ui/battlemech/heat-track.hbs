{{!--
templates/v2/ui/battlemech/heat-track.hbs
Purpose: Renders the prepared BattleMech heat monitor and status thresholds.
How it fits: Specific to the BattleMech V2 sheet systems tab.
--}}

<section class="mwd-monitor" data-monitor="heat">
  <header class="mwd-monitor__header">
    <div class="mwd-monitor__label">{{battlemechSheet.heat.label}}</div>
    <div class="mwd-monitor__status">
      <span class="mwd-monitor__status-label">Status</span>
      <span class="mwd-monitor__status-value">{{battlemechSheet.heat.status}}</span>
    </div>
  </header>

  <div class="mwd-monitor__pips" role="group" aria-label="{{battlemechSheet.heat.label}}">
    {{#each battlemechSheet.heat.segments as |segment|}}
      <button
        type="button"
        class="pip pip--monitor pip--heat {{#if segment.filled}}pip--filled{{else}}pip--empty{{/if}} {{#if segment.breakpoint}}pip--breakpoint{{/if}}"
        data-action="monitorSet"
        data-monitor="heat"
        data-value="{{segment.value}}"
        aria-label="Set heat to {{segment.value}}"
        {{#unless @root.battlemechSheet.heat.editable}}disabled{{/unless}}>
      </button>
    {{/each}}
  </div>

  {{#if editing}}
    <div class="mwd-gmgadget__grid" style="margin-top:0.5rem;">
      <label class="mwd-gmgadget__field">
        <span class="mwd-gmgadget__field-label">Max Heat</span>
        <input
          type="number"
          name="system.monitors.heat.max"
          value="{{battlemechSheet.heat.max}}"
          data-edit-field="staged"
        />
      </label>
      <label class="mwd-gmgadget__field">
        <span class="mwd-gmgadget__field-label">Dissipation</span>
        <input
          type="number"
          name="system.hybrid.heat.dissipation"
          value="{{battlemechSheet.heat.dissipation}}"
          data-edit-field="staged"
        />
      </label>
      <label class="mwd-gmgadget__field">
        <span class="mwd-gmgadget__field-label">Hot</span>
        <input
          type="number"
          name="system.mwd.heat.thresholds.runningHot"
          value="{{battlemechSheet.heat.thresholds.runningHot}}"
          data-edit-field="staged"
        />
      </label>
      <label class="mwd-gmgadget__field">
        <span class="mwd-gmgadget__field-label">Overheat</span>
        <input
          type="number"
          name="system.mwd.heat.thresholds.overheated"
          value="{{battlemechSheet.heat.thresholds.overheated}}"
          data-edit-field="staged"
        />
      </label>
      <label class="mwd-gmgadget__field">
        <span class="mwd-gmgadget__field-label">Danger</span>
        <input
          type="number"
          name="system.mwd.heat.thresholds.shutdown"
          value="{{battlemechSheet.heat.thresholds.shutdown}}"
          data-edit-field="staged"
        />
      </label>
    </div>
  {{else}}
    <section class="mwd-item-hero">
      <div class="mwd-item-hero__stat">
        <span class="mwd-item-hero__label">Current</span>
        <span class="mwd-item-hero__value">{{battlemechSheet.heat.current}} / {{battlemechSheet.heat.max}}</span>
      </div>
      <div class="mwd-item-hero__stat {{#if battlemechSheet.heat.coolingImpaired}}mwd-item-hero__stat--impaired{{/if}}">
        <span class="mwd-item-hero__label">Dissipation</span>
        <span class="mwd-item-hero__value">
          {{battlemechSheet.heat.effectiveDissipation}}
          {{#if battlemechSheet.heat.coolingImpaired}}
            <span class="mwd-item-hero__note">(impaired)</span>
          {{/if}}
        </span>
      </div>
      <div class="mwd-item-hero__stat">
        <span class="mwd-item-hero__label">Hot</span>
        <span class="mwd-item-hero__value">{{battlemechSheet.heat.thresholds.runningHot}}</span>
      </div>
      <div class="mwd-item-hero__stat">
        <span class="mwd-item-hero__label">Overheat</span>
        <span class="mwd-item-hero__value">{{battlemechSheet.heat.thresholds.overheated}}</span>
      </div>
      <div class="mwd-item-hero__stat">
        <span class="mwd-item-hero__label">Danger</span>
        <span class="mwd-item-hero__value">{{battlemechSheet.heat.thresholds.shutdown}}</span>
      </div>
    </section>

    {{!-- Active heat penalties --}}
    {{#if battlemechSheet.heat.inDanger}}
      <div class="mwd-heat-alert mwd-heat-alert--danger">
        <span class="mwd-heat-alert__label">DANGER</span>
        <span class="mwd-heat-alert__detail">Shutdown &amp; Explosion checks required</span>
      </div>
    {{/if}}

    {{#if battlemechSheet.heat.penalties.movementPenalty}}
      <div class="mwd-heat-penalty">
        <span class="mwd-heat-penalty__label">Movement</span>
        <span class="mwd-heat-penalty__value">−{{battlemechSheet.heat.penalties.movementPenalty}}</span>
        <span class="mwd-heat-penalty__note">ground speed (Hot)</span>
      </div>
    {{/if}}

    {{#if battlemechSheet.heat.penalties.rangedDicePenalty}}
      <div class="mwd-heat-penalty">
        <span class="mwd-heat-penalty__label">Ranged Dice</span>
        <span class="mwd-heat-penalty__value">−{{battlemechSheet.heat.penalties.rangedDicePenalty}}</span>
        <span class="mwd-heat-penalty__note">dice pool (Overheat)</span>
      </div>
    {{/if}}

    {{#if @root.battlemechSheet.heat.editable}}
      <div class="mwd-heat-actions">
        <button type="button" class="mwd-btn mwd-btn--heat" data-action="applyHeat">
          End Activation
        </button>
      </div>
    {{/if}}
  {{/if}}
</section>
