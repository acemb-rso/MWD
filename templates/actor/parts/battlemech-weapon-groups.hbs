{{!--
templates/actor/parts/battlemech-weapon-groups.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="section-group column">
  <h2 class="section-group-header">{{ANARCHY.actor.battlemech.weaponGroups}}</h2>
  <div class="items-group-list">
    {{#each system.weaponGroups as |group|}}
    <div class="item">{{group}}</div>
    {{/each}}
  </div>
</div>

