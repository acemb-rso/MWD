{{!--
templates/actor/parts/gears.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type" data-item-type="gear">
  <h2 class="section-group-header">
    {{ANARCHY.itemType.plural.gear}}
    {{> 'systems/mwd/templates/common/item-control-add.hbs' itemType='gear'}}
  </h2>
  <div class="items-group-list">
    {{#each items.gear as |gear|}}
    {{> "systems/mwd/templates/actor/parts/gear.hbs" gear}}
    {{/each}}
  </div>
</div>

