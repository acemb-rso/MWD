{{!--
templates/actor/parts/gmnotes.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


{{#if options.isGM}}
<div class="section-group column">
  <h2 class="section-group-header">
    {{ANARCHY.common.gmnotes}}
  </h2>
  <div class="editor actor-editor">
    {{editor
      system.gmnotes
      target="system.gmnotes"
      engine="prosemirror"
      collaborate=false
      owner=options.owner
      button=true
      editable=options.editable}}
  </div>
</div>
{{/if}}
