{{!--
templates/actor/parts/attributebutton.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<a class="item anarchy-button click-roll-attribute-action flex-grow-0"
  data-tooltip="{{label}}" data-action-code="{{code}}">
{{#if icon}}
  {{{icon}}}
{{else}}
  <label>{{label}}</label>
{{/if}}
</a>
