{{!--
templates/actor/parts/life-modules.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type" data-item-type="lifeModule">
  <h2 class="section-group-header">
    {{ANARCHY.itemType.plural.lifeModule}}
    {{> 'systems/mwd/templates/common/item-control-add.hbs' itemType='lifeModule'}}
  </h2>
  <div class="items-group-list">
    {{#each items.lifeModule as |lifeModule|}}
    {{> "systems/mwd/templates/actor/parts/life-module.hbs" lifeModule}}
    {{/each}}
  </div>
</div>

