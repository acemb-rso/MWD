{{!--
templates/actor/parts/contacts.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type" data-item-type="contact">
  <h2 class="section-group-header">
    {{ANARCHY.itemType.plural.contact}}
    {{> 'systems/mwd/templates/common/item-control-add.hbs' itemType='contact'}}
  </h2>
  <div class="flexrow flex-wrap">
    {{#each items.contact as |contact|}}
    {{> "systems/mwd/templates/actor/parts/contact.hbs" contact}}
    {{/each}}
  </div>
</div>
