{{!--
templates/actor/parts/owned-actors.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type" data-item-type="owned-actor">
  <h2 class="section-group-header">
    {{ANARCHY.actor.ownership.owned}}
  </h2>
  <div class="items-group-list">
    {{#each ownedActors as |ownedActor|}}
    {{> "systems/mwd/templates/actor/parts/owned-actor.hbs" ownedActor}}
    {{/each}}
  </div>
</div>
