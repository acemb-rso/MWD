{{!--
templates/actor/parts/asset-modules.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type" data-item-type="assetModule">
  <h2 class="section-group-header">
    {{ANARCHY.itemType.plural.assetModule}}
    {{> 'systems/mwd/templates/common/item-control-add.hbs' itemType='assetModule'}}
  </h2>
  <div class="items-group-list">
    {{#each (sortAssetModules items.assetModule) as |assetModule|}}
    {{> "systems/mwd/templates/actor/parts/asset-module.hbs" assetModule}}
    {{/each}}
  </div>
</div>

