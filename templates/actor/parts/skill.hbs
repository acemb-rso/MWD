{{!--
templates/actor/parts/skill.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout. Includes form controls or labeled fields.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type item anarchy-skill" data-item-id="{{_id}}" data-item-type="skill" draggable="true">
  {{#if img}}
  <img class="anarchy-img item-img" src="{{img}}" alt="{{name}}" data-tooltip="{{name}}"/>
  {{/if}}
  {{#if (or (eq system.code 'knowledge') (eq system.attribute 'knowledge')) }}
  <span data-tooltip="{{ANARCHY.attributes.knowledge}}">
    {{{iconFA 'fas fa-user-graduate'}}}
    <label>{{name}}</label>
  </span>
  {{else}}
    <div class="flexcol">
      <span class="flexrow">
        <a class="click-skill-roll">
          <label data-tooltip="{{localizeAttribute system.attribute}} + {{system.value}}">
            {{name}}: {{skillValue @root.actor _id}}
          </label>
        </a>
      </span>
    </div>
  {{/if}}
  <div class="item-controls">
    {{> 'systems/mwd/templates/common/favorite.hbs'
      isFavorite=(actorHasFavorite @root.actor.id id=_id type=type)
      skill=this
    }}
    {{> 'systems/mwd/templates/common/item-controls.hbs'}}
  </div>
</div>
