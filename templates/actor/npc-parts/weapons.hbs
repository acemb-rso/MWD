{{!--
templates/actor/npc-parts/weapons.hbs
Purpose: Renders collections with `each` blocks. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<div class="define-item-type" data-item-type="weapon">
  <h2 class="section-group-header">
    {{ANARCHY.itemType.plural.weapon}}
    {{> 'systems/mwd/templates/common/item-control-add.hbs' itemType='weapon'}}
  </h2>
  <ul class="weapon-list">
    {{#each items.weapon as |weapon|}}
    {{> "systems/mwd/templates/actor/npc-parts/weapon.hbs" weapon}}
    {{/each}}
  </ul>
</div>

