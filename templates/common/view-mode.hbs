{{!--
templates/common/view-mode.hbs
Purpose: Contains conditional display logic. Contains styled HTML nodes for UI layout.
How it fits: Used by rendering code to produce UI fragments.
--}}


<label class="view-mode-toggle">
  {{#if @root.options.viewMode}}
    <a class="view-mode-control"
       data-action="toggleViewMode"
       data-tooltip="{{ANARCHY.common.editMode}}">
      <i>{{{iconFA "fa-solid fa-lock"}}}</i>
    </a>
  {{else}}
    <a class="view-mode-control"
       data-action="toggleViewMode"
       data-tooltip="{{ANARCHY.common.viewMode}}">
      <i>{{{iconFA "fa-solid fa-lock-open"}}}</i>
    </a>
  {{/if}}
</label>

