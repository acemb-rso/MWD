{{!--
templates/common/enum-value-label.hbs
Purpose: Renders collections with `each` blocks.
How it fits: Used by rendering code to produce UI fragments.
--}}


{{!
  data is:
  {
    // the entries to propose as options
    entries: [
      { "value": "k1", "label": "label1"},
      { "value": "k2", "labelkey": "ANARCHY.(...).label2"},
    ]
  }
}}
{{#unless noEmpty}}
<option value="" {{#if (eq selected "")}}selected{{/if}}></option>
{{/unless}}
{{#each entries as |entry|}}
<option value="{{entry.value}}" {{#if (eq ../selected entry.value)}}selected{{/if}}>{{> 'systems/mwd/templates/common/label.hbs' entry}}</option>
{{/each}}
