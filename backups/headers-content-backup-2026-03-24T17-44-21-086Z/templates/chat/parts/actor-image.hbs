<img class="anarchy-img actor-img open-actor-sheet" src="{{actor.img}}" alt="{{actor.name}}"
  data-tooltip="{{actor.name}}"
  data-actor-id="{{actor.id}}"
  {{#if actor.isToken}}data-token-id="{{actor.token.id}}"{{/if}}
  />