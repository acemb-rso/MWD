{{!--
templates/roll/parts/image-weapon.hbs
Purpose: Handlebars template for image-weapon. Used to render UI in the system.
--}}

{{#if skill.img}}
<img class="anarchy-img skill-img flex-shrink" src="{{skill.img}}" alt="{{skill.name}}" data-tooltip="{{skill.name}}"/>
{{/if}}
{{#unless (eq skill.img weapon.img)}}
<img class="anarchy-img weapon-img flex-shrink" src="{{weapon.img}}" alt="{{weapon.name}}" data-tooltip="{{weapon.name}}"/>
{{/unless}}