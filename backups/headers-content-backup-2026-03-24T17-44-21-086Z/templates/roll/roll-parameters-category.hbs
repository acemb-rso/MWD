{{!--
templates/roll/roll-parameters-category.hbs
Purpose: Handlebars template for roll-parameters-category. Used to render UI in the system.
--}}

{{#each parameters as |parameter|}}
  {{#if (eq category ../category)}}
    {{#unless hideParameter}}
      <div class="parameter" data-parameter-code="{{code}}" {{#if item}}data-item-id="{{item.id}}"{{/if}}>
        {{> (either hbsTemplateRoll 'systems/mwd/templates/roll/parts/generic.hbs') parameter}}
      </div>
    {{/unless}}
  {{/if}}
{{/each}}
