{{!--
templates/v2/components/view-mode.hbs
Purpose: Handlebars template for view-mode. Used to render UI in the system.
--}}

<label class="view-mode-toggle">
  {{#if @root.options.viewMode}}
    <a class="view-mode-control"
       data-action="toggleViewMode"
       data-tooltip="{{MWD.common.editMode}}">
      <i>{{{iconFA "fa-solid fa-lock"}}}</i>
    </a>
  {{else}}
    <a class="view-mode-control"
       data-action="toggleViewMode"
       data-tooltip="{{MWD.common.viewMode}}">
      <i>{{{iconFA "fa-solid fa-lock-open"}}}</i>
    </a>
  {{/if}}
</label>

