{{!--
templates/actor/parts/gmnotes.hbs
Purpose: Handlebars template for gmnotes. Used to render UI in the system.
--}}

{{#if options.isGM}}
<div class="section-group column">
  <h2 class="section-group-header">
    {{ANARCHY.common.gmnotes}}
  </h2>
  <div class="editor actor-editor">
    {{editor
      system.gmnotes
      target="system.gmnotes"
      owner=options.owner
      button=true
      editable=options.editable}}
  </div>
</div>
{{/if}}
