# Text is stored and checked out with LF line endings (Linux-only workflow).
* text=auto eol=lf

# Binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary
*.db binary
*.mp3 binary
*.ogg binary
*.webm binary
*.mp4 binary

# Kept byte-exact: asset library, compendium LevelDB stores (CURRENT/LOG/
# MANIFEST are LevelDB internals, not editable text), and fonts.
img/** -text
packs/** -text
fonts/** -text

# Generated by `npm run build`; committed exactly as Vite writes it.
dist/** -text
stats.html -text
